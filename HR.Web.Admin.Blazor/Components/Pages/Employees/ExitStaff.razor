@page "/employees/exit"
@using HR.Data
@using HR.Data.Models.EmployestatusLog
@using HR.Core.Enums
@using Microsoft.EntityFrameworkCore
@inject HRDbContext Db
@inject NavigationManager Navigation
@rendermode InteractiveServer
@inject IJSRuntime JS

<div class="container-fluid py-4 min-vh-100">
  @* --- TOP STATISTICS --- *@
  <div class="row g-3 mb-4">
    <div class="col-md-3">
      <div class="card border-0 shadow-sm p-3 border-start border-danger border-4">
        <div class="d-flex align-items-center">
          <div class="icon-shape bg-soft-danger text-danger rounded-circle p-3 me-3">
            <i class="fas fa-user-minus fa-lg"></i>
          </div>
          <div>
            <h6 class="text-muted mb-0 small">Total Exits</h6>
            <h3 class="fw-bold mb-0">@exitLogs?.Count</h3>
          </div>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card border-0 shadow-sm p-3 border-start border-warning border-4">
        <div class="d-flex align-items-center">
          <div class="icon-shape bg-soft-warning text-warning rounded-circle p-3 me-3">
            <i class="fas fa-clock fa-lg"></i>
          </div>
          <div>
            <h6 class="text-muted mb-0 small">Avg. Tenure</h6>
            <h3 class="fw-bold mb-0">3.2 Yrs</h3>
          </div>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card border-0 shadow-sm p-3 border-start border-info border-4">
        <div class="d-flex align-items-center">
          <div class="icon-shape bg-soft-info text-info rounded-circle p-3 me-3">
            <i class="fas fa-hand-holding-usd fa-lg"></i>
          </div>
          <div>
            <h6 class="text-muted mb-0 small">Pending Pay</h6>
            <h3 class="fw-bold mb-0">@exitLogs?.Count(x => !x.FinalPayProcessed)</h3>
          </div>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card border-0 shadow-sm p-3 border-start border-success border-4">
        <div class="d-flex align-items-center">
          <div class="icon-shape bg-soft-success text-success rounded-circle p-3 me-3">
            <i class="fas fa-check-double fa-lg"></i>
          </div>
          <div>
            <h6 class="text-muted mb-0 small">Cleared</h6>
            <h3 class="fw-bold mb-0">@exitLogs?.Count(x => x.FinalPayProcessed)</h3>
          </div>
        </div>
      </div>
    </div>
  </div>

  @* --- MAIN LIST --- *@
  <div class="card border-0 shadow-sm" style="border-radius: 12px;">
    <div class="card-header py-3 border-bottom">
      <div class="d-flex justify-content-between align-items-center">
        <h5 class="fw-bold mb-0">Exit Clearance Registry</h5>
        <button class="btn btn-sm btn-dark px-3" @onclick="PrintFullReport">
          <i class="fas fa-file-pdf me-2"></i>Full Audit Report
        </button>
      </div>
    </div>
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-primary text-muted small">
          <tr>
            <th class="ps-4">EMPLOYEE</th>
            <th>TYPE / STATUS</th>
            <th>FINANCIALS</th>
            <th>RE-HIRE</th>
            <th>DATES</th>
            <th class="text-end pe-4">ACTIONS</th>
          </tr>
        </thead>
        <tbody>
          @if (exitLogs != null)
          {
            @foreach (var log in exitLogs)
            {
              <tr>
                <td class="ps-4">
                  <div class="fw-bold text-primary">@log.Employee.FirstName @log.Employee.LastName</div>
                  <div class="text-muted x-small">ID: @log.Employee.Id.ToString().Substring(0, 8)</div>
                </td>
                <td>
                  <span class="badge rounded-pill @GetStatusClass(log.NewStatus)">@log.NewStatus</span>
                </td>
                <td>
                  @if (log.FinalPayProcessed)
                  {
                    <span class="text-success small fw-bold"><i class="fas fa-check-circle me-1"></i> Paid</span>
                  }
                  else
                  {
                    <span class="text-danger small fw-bold"><i class="fas fa-exclamation-circle me-1"></i> Pending</span>
                  }
                </td>
                <td>
                  @if (log.IsRehireable)
                  {
                    <i class="fas fa-thumbs-up text-success" title="Eligible for Re-hire"></i>
                  }
                  else
                  {
                    <i class="fas fa-ban text-danger" title="Do Not Re-hire"></i>
                  }
                </td>
                <td>
                  <div class="small fw-bold">Exit: @log.EffectiveDate.ToShortDateString()</div>
                  <div class="text-muted x-small">Notice: @(log.NoticeDate?.ToShortDateString() ?? "None")</div>
                </td>
                <td class="text-end pe-4">
                  <button class="btn btn-light btn-sm rounded-pill shadow-sm me-1" @onclick="() => ViewDetails(log)">
                    <i class="fas fa-eye text-primary"></i>
                  </button>
                  <button class="btn btn-light btn-sm rounded-pill shadow-sm"
                          title="Print Certificate"
                          @onclick="() => PrintCertificate(log.Id)">
                    <i class="fas fa-print me-2 text-warning"></i>
                  </button>
                </td>
              </tr>
            }
          }
        </tbody>
      </table>
    </div>
  </div>
</div>

@* --- DETAILED VIEW MODAL --- *@
@if (selectedLog != null)
{
  <div class="modal fade show d-block" style="background: rgba(0,0,0,0.6); z-index: 1060;">
    <div class="modal-dialog modal-lg modal-dialog-centered">
      <div class="modal-content border-0 shadow-lg">

        <div class="modal-header bg-primary text-white p-4 no-print">
          <h5 class="modal-title fw-bold">
            <i class="fas fa-user-shield me-2"></i> Exit Profile: @selectedLog.Employee.FirstName @selectedLog.Employee.LastName
          </h5>
          <button type="button" class="btn-close btn-close-white" @onclick="CloseModal"></button>
        </div>

        @* --- PRINTABLE AREA START --- *@
        <div class="modal-body p-4" id="printArea">
          @* Professional Header: Only visible when printing *@
          <div class="d-none d-print-block text-center mb-4">
            <h2 class="fw-bold">JANTA HR MANAGEMENT</h2>
            <h5 class="text-muted border-bottom pb-2">OFFICIAL EXIT CLEARANCE RECORD</h5>
          </div>

          <div class="row g-4">
            <div class="col-md-6">
              <h6 class="fw-bold border-bottom pb-2">Exit Information</h6>
              <table class="table table-sm table-borderless small">
                <tr><td class="text-muted">Employee:</td><td class="fw-bold">@selectedLog.Employee.FirstName @selectedLog.Employee.LastName</td></tr>
                <tr><td class="text-muted">Exit Reason:</td><td class="fw-bold">@selectedLog.Reason</td></tr>
                <tr><td class="text-muted">Effective Date:</td><td>@selectedLog.EffectiveDate.ToString("D")</td></tr>
                <tr><td class="text-muted">Notice Given:</td><td>@(selectedLog.NoticeDate?.ToString("D") ?? "No Notice Period")</td></tr>
                <tr><td class="text-muted">Last Day Worked:</td><td>@(selectedLog.LastWorkDate?.ToString("D") ?? "N/A")</td></tr>
                <tr><td class="text-muted">Authorized By:</td><td class="text-success fw-bold">@selectedLog.AuthorizedBy</td></tr>
              </table>
            </div>
            <div class="col-md-6">
              <h6 class="fw-bold border-bottom pb-2">Compliance & HR</h6>
              <div class="p-3 bg-light rounded">
                <p class="mb-1 small"><strong>HR Notes:</strong></p>
                <p class="small text-muted italic">"@(selectedLog.Notes ?? "No additional notes provided.")"</p>
              </div>
              <div class="mt-3">
                <div class="d-flex justify-content-between align-items-center small p-2 border rounded mb-2">
                  <span>Re-hire Eligibility</span>
                  <span class="badge @(selectedLog.IsRehireable ? "bg-success" : "bg-danger")">@(selectedLog.IsRehireable ? "Yes" : "No")</span>
                </div>
                <div class="d-flex justify-content-between align-items-center small p-2 border rounded">
                  <span>Financial Clearance</span>
                  <span class="badge @(selectedLog.FinalPayProcessed ? "bg-success" : "bg-warning text-dark")">@(selectedLog.FinalPayProcessed ? "Cleared" : "Pending")</span>
                </div>
              </div>
            </div>
          </div>

          @* Professional Footer: Only visible when printing *@
          <div class="d-none d-print-block mt-5">
            <div class="row pt-4">
              <div class="col-6 text-center">
                <div class="border-top pt-2 small">HR Manager Signature</div>
              </div>
              <div class="col-6 text-center">
                <div class="border-top pt-2 small">Date of Issue: @DateTime.Now.ToShortDateString()</div>
              </div>
            </div>
          </div>
        </div>
        @* --- PRINTABLE AREA END --- *@

        <div class="modal-footer bg-light p-3 no-print">
          <button class="btn btn-outline-secondary" @onclick="CloseModal">Close</button>
          <button class="btn btn-dark"
                  title="Print Certificate"
                  @onclick="() => PrintCertificate()">
            <i class="fas fa-print me-2 text-warning"></i>
            Print to PDF
          </button>
        </div>
      </div>
    </div>
  </div>
}
@code {
  private List<EmployeeStatusLog>? exitLogs;
  private EmployeeStatusLog? selectedLog;

  protected override async Task OnInitializedAsync()
  {
    exitLogs = await Db.Set<EmployeeStatusLog>()
        .Include(l => l.Employee)
        .Where(l => (int)l.NewStatus >= 4) 
        .OrderByDescending(l => l.EffectiveDate)
        .ToListAsync();
  }
  private async Task PrintCertificate(Guid? logId = null)
  {
    // 1. If an ID is passed (from the table), find and select that log first
    if (logId.HasValue)
    {
      selectedLog = exitLogs?.FirstOrDefault(x => x.Id == logId.Value);
      StateHasChanged(); // Refresh UI to ensure modal data is loaded

      // Small delay to allow the browser to render the modal content before printing
      await Task.Delay(100);
    }

    // 2. Trigger the print dialog
    await JS.InvokeVoidAsync("window.print");
  }
  private void PrintFullReport()
  {
    // forceLoad: true ensures we get a clean page reload for the report
    Navigation.NavigateTo("/employees/exit/audit-report", forceLoad: true);
  }
  private void ViewDetails(EmployeeStatusLog log) => selectedLog = log;
  private void CloseModal() => selectedLog = null;

  private string GetStatusClass(EmployeeStatus status) => status switch
  {
    EmployeeStatus.Terminated => "bg-danger",
    EmployeeStatus.Resigned => "bg-info",
    EmployeeStatus.Retired => "bg-success",
    EmployeeStatus.ContractEnded => "bg-dark text-white",
    _ => "bg-secondary"
  };

}

<style>
  /* Use double @@ to tell Blazor this is CSS, not C# */
  @@media print {
    /* 1. Hide everything on the main page */
    body * {
      visibility: hidden;
    }
    /* 2. Only show the modal and its content */
    .modal.show, .modal.show * {
      visibility: visible;
    }
    /* 3. Position the modal at the very top-left of the paper */
    .modal.show {
      position: absolute;
      left: 0;
      top: 0;
      width: 100%;
      margin: 0;
      padding: 0;
    }
    /* 4. Hide buttons and UI junk you don't want on paper */
    .no-print, .btn, .btn-close, .modal-footer, .sidebar, .nav {
      display: none !important;
    }

    #printArea, #printArea * {
      visibility: visible !important;
    }
    /* Position the printArea at the very top of the PDF page */
    #printArea {
      position: fixed;
      left: 0 !important;
      top: 0 !important;
      width: 100%;
      margin: 0 !important;
      padding: 30px !important;
      background-color: white !important;
    }
    /* Ensure no buttons or background UI show up */
    .no-print, .modal-footer, .modal-header, .btn, .sidebar, .nav {
      display: none !important;
    }
    /* 5. Clean up modal borders for paper */
    .modal-content {
      border: none !important;
      box-shadow: none !important;
    }

    .modal-header {
      background-color: white !important;
      color: black !important;
      border-bottom: 2px solid #000 !important;
    }
  }

  /* Normal Page Styles */
  .bg-soft-danger {
    background-color: #fceaea;
  }

  .bg-soft-warning {
    background-color: #fff8e1;
  }

  .bg-soft-info {
    background-color: #e1f5fe;
  }

  .bg-soft-success {
    background-color: #e8f5e9;
  }

  .x-small {
    font-size: 0.7rem;
  }
</style>