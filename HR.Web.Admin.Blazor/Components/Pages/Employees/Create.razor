@using Microsoft.AspNetCore.Hosting
@inject IWebHostEnvironment Environment

// ... inside @code ...

private async Task HandleFileSelected(InputFileChangeEventArgs e)
{
  var file = e.File;
  if (file != null)
  {
    // 1. Define the folder path
    var folderPath = Path.Combine(Environment.WebRootPath, "uploads", "disability_certs");

    // 2. Ensure folder exists
    if (!Directory.Exists(folderPath))
    {
      Directory.CreateDirectory(folderPath);
    }

    // 3. Create a secure File Name (EmployeeID + Original Extension)
    // Using a Guid or Temp ID since the employee might not be saved yet
    var extension = Path.GetExtension(file.Name);
    var fileName = $"CERT_{Guid.NewGuid()}{extension}";
    var fullPath = Path.Combine(folderPath, fileName);

    // 4. Save to Disk
    using var stream = file.OpenReadStream(maxAllowedSize: 1024 * 1024 * 5); // 5MB limit
    using var fileStream = new FileStream(fullPath, FileMode.Create);
    await stream.CopyToAsync(fileStream);

    // 5. Store ONLY the relative path in your model
    if (TempService.TempEmployee.DisabilityDetail == null)
      TempService.TempEmployee.DisabilityDetail = new();

    TempService.TempEmployee.DisabilityDetail.CertificateFileName = file.Name;
    TempService.TempEmployee.DisabilityDetail.CertificateFilePath = $"/uploads/disability_certs/{fileName}";

    Console.WriteLine($"✅ File saved to: {fullPath}");
  }
}
}




