@page "/employees/exit/audit-report"
@using HR.Data
@using HR.Data.Models.EmployestatusLog
@using Microsoft.EntityFrameworkCore
@using HR.Web.Admin.Blazor.Components.Layout
@inject HRDbContext Db
@inject IJSRuntime JS
@layout EmptyLayout 

<div class="report-container">
    @* --- REPORT HEADER --- *@
    <div class="report-header">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h1 class="company-name">JANTA HR MANAGEMENT</h1>
                <p class="mb-0">Personnel & Operations Department</p>
                <p class="small text-muted">Confidential Audit Document</p>
            </div>
            <div class="text-end">
                <h2 class="report-title">EXIT AUDIT REGISTRY</h2>
                <p class="mb-0">Generated: @DateTime.Now.ToString("f")</p>
            </div>
        </div>
        <hr class="header-line" />
    </div>

    @* --- DATA TABLE --- *@
    <div class="report-body">
        <table class="audit-table">
            <thead>
                <tr>
                    <th>Emp. ID</th>
                    <th>Employee Name</th>
                    <th>Exit Type</th>
                    <th>Effective Date</th>
                    <th>Financial Status</th>
                    <th>Re-hire</th>
                    <th>Authorized By</th>
                </tr>
            </thead>
            <tbody>
                @if (allLogs != null)
                {
                    @foreach (var log in allLogs)
                    {
                        <tr>
                            <td>@log.Employee.EmployeeCode</td>
                            <td class="fw-bold">@log.Employee.FirstName @log.Employee.LastName</td>
                            <td>@log.NewStatus</td>
                            <td>@log.EffectiveDate.ToString("dd/MM/yyyy")</td>
                            <td>@(log.FinalPayProcessed ? "Cleared" : "Pending")</td>
                            <td>@(log.IsRehireable ? "Yes" : "No")</td>
                            <td>@log.AuthorizedBy</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @* --- REPORT FOOTER --- *@
    <div class="report-footer">
        <div class="d-flex justify-content-between">
            <div class="footer-sign">
                <p>Internal Audit Signature</p>
                <div class="sign-line"></div>
            </div>
            <div class="footer-sign">
                <p>HR Director Approval</p>
                <div class="sign-line"></div>
            </div>
        </div>
        <p class="text-center mt-5 x-small">End of Document - Page 1 of 1</p>
    </div>
</div>

@* --- PRINT CONTROLS (Floating for User) --- *@
<div class="print-toolbar no-print">
    <button class="btn btn-dark btn-lg shadow" @onclick="TriggerPrint">
        <i class="fas fa-print me-2"></i> Print to PDF
    </button>
</div>

<style>
    .report-container {
        max-width: 1100px;
        margin: 20px auto;
        padding: 40px;
        background: white;
        color: #333;
        font-family: 'Times New Roman', Times, serif;
    }

    .header-line { border-top: 4px solid #1a1a1a; opacity: 1; }
    .report-title { color: #d9534f; font-weight: bold; }
    
    .audit-table { width: 100%; border-collapse: collapse; margin-top: 20px; font-size: 0.9rem; }
    .audit-table th { background: #f2f2f2; border: 1px solid #ddd; padding: 12px; text-align: left; }
    .audit-table td { border: 1px solid #ddd; padding: 10px; }
    
    .sign-line { border-top: 1px solid #000; width: 200px; margin-top: 40px; }
    
    .print-toolbar { position: fixed; bottom: 30px; right: 30px; }

    @@media print {
        .no-print { display: none !important; }
        .report-container { margin: 0; padding: 0; width: 100%; }
        body { background: white !important; }
    }
</style>

@code {
    private List<EmployeeStatusLog>? allLogs;

    protected override async Task OnInitializedAsync()
    {
        allLogs = await Db.Set<EmployeeStatusLog>()
            .Include(l => l.Employee)
            .OrderByDescending(l => l.EffectiveDate)
            .ToListAsync();
    }

    private async Task TriggerPrint() => await JS.InvokeVoidAsync("window.print");
}