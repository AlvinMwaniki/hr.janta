@page "/employees/additional/nextofkin"
@using HR.Data
@using DataModels = HR.Data.Models.Employees 
@using Microsoft.EntityFrameworkCore
@using HR.Services.Services
@inject EmployeeTempService TempService
@inject NavigationManager Navigation
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Forms
@using HR.Data.Models.Country;
@inject HRDbContext Db
@inject IJSRuntime JSRuntime

<h3>Step 4: Next of Kin</h3>

<EditForm EditContext="@editContext" OnValidSubmit="AddOrUpdateNextOfKin" FormName="Step4">
  <DataAnnotationsValidator />
  <Microsoft.AspNetCore.Components.Forms.ValidationSummary />

  <div class="form-card">

    <!-- Row 1: Full Name, Relationship -->
    <div class="row mb-2">
      <div class="col-md-6">
        <label class="form-label">Full Name</label>
        <InputText @bind-Value="nokModel.FullName" class="form-control" />
        <ValidationMessage For="@(() => nokModel.FullName)" />
      </div>
      <div class="col-md-6">
        <label class="form-label">Relationship</label>
        <InputText @bind-Value="nokModel.Relationship" class="form-control" />
        <ValidationMessage For="@(() => nokModel.Relationship)" />

      </div>
    </div>

    <!-- Row 2: Phone -->
    <div class="row mb-2">
      <div class="col-md-4">
        <label class="form-label fw-bold">Phone Number</label>
        <div class="input-group mb-3">
          <button class="btn btn-light border-secondary-subtle dropdown-toggle d-flex align-items-center"
                  type="button" data-bs-toggle="dropdown" aria-expanded="false" style="min-width: 90px;">
            @if (selectedCountry != null)
            {
              <img src="@selectedCountry.FlagUrl" class="me-2" style="width: 20px; height: 14px; border: 1px solid #dee2e6;" />
              <span class="fw-bold">@selectedCountry.IsoCode</span>
            }
          </button>

          <ul class="dropdown-menu shadow" style="max-height: 300px; overflow-y: auto;">
            @foreach (var c in countries.OrderBy(x => x.Name))
            {
              <li>
                <button type="button" class="dropdown-item d-flex align-items-center" @onclick="() => SelectCountry(c)">
                  <img src="@c.FlagUrl" class="me-2" style="width: 20px; border: 1px solid #eee;" />
                  <span>@c.Name (@c.DialCode)</span>
                </button>
              </li>
            }
          </ul>

          <InputText @bind-Value="nokModel.Phone"
                     class="form-control"
                     placeholder="712 345 678"
                     maxlength="10" />
        </div>
        <ValidationMessage For="@(() => nokModel.Phone)" class="text-danger small" />
      </div>

      <!-- Removed the Email input field -->
    </div>

    <!-- Row 3: Address -->
    <div class="row mb-2">
      <div class="col-md-12">
        <label class="form-label">Address</label>
        <InputTextArea @bind-Value="nokModel.Address" class="form-control" />
        <ValidationMessage For="@(() => nokModel.Address)" />

      </div>
    </div>

    <div class="mt-3">
      <button type="submit" class="btn btn-primary px-4 shadow-sm">
        <i class="fas @(editingNokIndex >= 0 ? "fa-save" : "fa-plus") me-2"></i>
        @((editingNokIndex >= 0) ? "Update" : "Add")
    </button>
      @* Show BACK button here ONLY if no education has been added yet *@
      @if (!TempService.TempEmployee.NextOfKin.Any())
      {
        <button type="button" class="btn btn-outline-secondary ms-2" @onclick="GoBack">Back</button>
      }
    </div>
  </div>
</EditForm>


@if (TempService.TempEmployee.NextOfKin.Any())
{
  <div class="card shadow-sm border-0 mt-5 overflow-hidden" style="border-radius: 12px;">
    <div class="table-responsive">
      <table class="table table-hover mb-0">
        <thead style="background-color: #222240; color: white;">
      <tr>
            <th class="ps-4 py-3" style="background-color: #222240; color: white;">Full Name</th>
            <th class="py-3" style="background-color: #222240; color: white;">Relationship</th>
            <th class="py-3" style="background-color: #222240; color: white;">Phone</th>
            <th class="py-3" style="background-color: #222240; color: white;">Address</th>
            <th class="py-3" style="background-color: #222240; color: white;">Actions</th>
      </tr>
    </thead>
    <tbody>
      @for (int i = 0; i < TempService.TempEmployee.NextOfKin.Count; i++)
      {
        var nok = TempService.TempEmployee.NextOfKin[i];
        <tr>
          <td>@nok.FullName</td>
          <td>@nok.Relationship</td>
          <td>@nok.Phone</td>
          <td>@nok.Address</td>
          <td>
            <button class="btn btn-sm btn-warning me-1" @onclick="() => EditNok(nok)">Edit</button>
            <button class="btn btn-sm btn-danger" @onclick="() => DeleteNok(nok)">Delete</button>
          </td>
        </tr>
      }
    </tbody>
  </table>
  </div>
  </div>

  <div class="d-flex justify-content-between mt-4 pb-5">
    <button class="btn btn-secondary me-2" @onclick="GoBack">
      <i class="fas fa-arrow-left me-2"></i> Back
    </button>
    <button class="btn btn-success" @onclick="NextStep">
      Next <i class="fas fa-arrow-right ms-2"></i>
    </button>
  </div>
}


@code {


  // Use the alias when declaring the model type
  private DataModels.NextOfKin nokModel = new();
  private int editingNokIndex = -1;
  private EditContext? editContext;

  protected override async Task OnInitializedAsync()
  {
    editContext = new EditContext(nokModel)!;
    // Load country data
    // Load countries for phone codes
    countries = await Db.Countries.OrderBy(c => c.Name).ToListAsync();
    // SET DEFAULT TO KENYA if it's a new employee
    selectedCountry = countries.FirstOrDefault(c => c.DialCode == "+254" || c.IsoCode == "KE");
  }

  private async Task AddOrUpdateNextOfKin(EditContext context)
  {

    // smart for phone
    if (selectedCountry != null && !string.IsNullOrWhiteSpace(nokModel.Phone))
    {
      // Format phone number to
      // Clean: Remove '0' and all non-numeric chars
      var digitsOnly = new string(nokModel.Phone.Where(char.IsDigit).ToArray());   
      // STRICT CHECK: If it's not 9 or 10 digits, STOP HERE.
      if (digitsOnly.Length < 9 || digitsOnly.Length > 10)
      {
        return; // The UI validation message will already be showing the error
      }

      if (digitsOnly.StartsWith("0")) digitsOnly = digitsOnly.Substring(1);

      // Result: 254712345678
      string dial = selectedCountry.DialCode.Replace("+", "");
      nokModel.Phone = dial + digitsOnly;
    }
    // Check if we are editing or adding new
    if (editingNokIndex >= 0)
    {
      TempService.UpdateNextOfKin(editingNokIndex, nokModel);
      editingNokIndex = -1;
    }
    else
    {
      TempService.AddNextOfKin(nokModel);
    }

    // Reset the form model and the EditContext
    nokModel = new DataModels.NextOfKin();
    editContext = new EditContext(nokModel)!;
    selectedCountry = countries.FirstOrDefault(x => x.IsoCode == "KE");
    StateHasChanged(); // Update UI
    await Task.Delay(100);
    await JSRuntime.InvokeVoidAsync("scrollToBottom");


  }

  private void EditNok(DataModels.NextOfKin itemToEdit)
  {
    // CRITICAL: Find the index of the object passed in
    int index = TempService.TempEmployee.NextOfKin.IndexOf(itemToEdit);

    if (index == -1) return; // Safely exit if the item is somehow missing

    // Create a deep copy from the item passed in
    nokModel = new DataModels.NextOfKin
    {
      Id = itemToEdit.Id,
      EmployeeId = itemToEdit.EmployeeId,
      FullName = itemToEdit.FullName,
      Relationship = itemToEdit.Relationship,
      Phone = itemToEdit.Phone,
      Address = itemToEdit.Address
    };
    editingNokIndex = index; // Use the found index for update tracking
    editContext = new EditContext(nokModel)!;
    StateHasChanged();
  }

  private void DeleteNok(DataModels.NextOfKin itemToDelete)
  {
    // CRITICAL: Find the index of the object passed in
    int index = TempService.TempEmployee.NextOfKin.IndexOf(itemToDelete);

    if (index == -1) return; // Safely exit

    // Remove the item using the found index
    TempService.RemoveNextOfKin(index);

    // Reset form state
    editingNokIndex = -1;
    nokModel = new DataModels.NextOfKin();
    editContext = new EditContext(nokModel)!;
    StateHasChanged();
  }

  private void GoBack()
  {
    // Go back to Work History page
    Navigation.NavigateTo("/employees/workhistory");
    StateHasChanged();
  }

  private void NextStep()
  {
    // Navigate to the next step, assuming Hobbies page now
    Navigation.NavigateTo($"/employees/additional/bankpayment/");
    StateHasChanged();
  }
  // Country data for phone number dropdown
  List<Country> countries = new();
  private Country? selectedCountry;
  private void SelectCountry(Country country)
  {
    selectedCountry = country;
    TempService.TempEmployee.CountryId = country.Id;
  }
}
