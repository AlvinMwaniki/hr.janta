@page "/admin/recruitment/applications"
@using HR.Data.Models.Recruitment
@using HR.Services.Interfaces
@inject IJobApplicationService JobAppService
@inject NavigationManager Nav
@rendermode InteractiveServer
@inject IConfiguration Config

<div class="container-fluid py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold prox-header-text mb-0">ATS: INCOMING APPLICATIONS</h2>
    <div class="d-flex gap-2">
      <span class="badge bg-primary rounded-pill px-3">@applications?.Count New</span>
    </div>
  </div>

  @if (applications == null)
  {
    <div class="text-center p-5"><div class="spinner-border text-primary"></div></div>
  }
  else
  {
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
      <table class="table table-hover align-middle mb-0">
        <thead class="bg-dark text-white">
          <tr>
            <th class="ps-4">Candidate</th>
            <th>Position Match</th>
            <th>Suitability Score</th>
            <th class="text-end pe-4">Actions</th>
          </tr>
        </thead>
        <tbody>
          @foreach (var app in applications)
          {
            <tr>
              <td class="ps-4">
                <div class="fw-bold">@app.FullName</div>
                <div class="text-muted x-small">@app.Email | @app.AppliedAt.ToShortDateString()</div>
              </td>
              <td>
                <div class="fw-semibold">@app.JobListing?.ExternalTitle</div>
                <div class="x-small text-primary">@app.SkillsFound</div>
              </td>
              <td style="width: 200px;">
                <div class="d-flex align-items-center gap-2">
                  <div class="progress w-100" style="height: 8px;">
                    <div class="progress-bar @GetScoreColor(app.SuitabilityScore)"
                         style="width: @app.SuitabilityScore%"></div>
                  </div>
                  <span class="fw-bold">@app.SuitabilityScore%</span>
                </div>
              </td>
              <td class="text-end pe-4">
                <button class="btn btn-sm btn-outline-dark rounded-pill px-3" @onclick="() => OpenDetails(app)">
                  VIEW PROFILE
                </button>
              </td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  }
</div>

@if (selectedApp != null)
{
  <div class="modal fade show d-block" style="background: rgba(0,0,0,0.7); backdrop-filter: blur(8px);">
    <div class="modal-dialog modal-xl modal-dialog-centered">
      <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">

        @* Header *@
        <div class="modal-header bg-dark text-white p-4">
          <div class="d-flex align-items-center">
            <div class="bg-primary rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 50px; height: 50px;">
              <i class="fas fa-user-tie fa-lg"></i>
            </div>
            <div>
              <h4 class="modal-title fw-bold mb-0">@selectedApp.FullName.ToUpper()</h4>
              <span class="badge bg-info text-dark">Applying for: @(selectedApp.JobListing?.ExternalTitle ?? "General Position")</span>
            </div>
          </div>
          <button type="button" class="btn-close btn-close-white" @onclick="() => selectedApp = null"></button>
        </div>

        <div class="modal-body p-0" style="max-height: 80vh; overflow-y: auto;">
          <div class="row g-0">

            @* Left Column: Contact & AI Analysis *@
            <div class="col-md-4 bg-light border-end p-4">
              <h6 class="fw-bold text-uppercase small text-muted mb-3">Contact Information</h6>
              <div class="mb-4">
                <div class="d-flex align-items-center mb-2">
                  <i class="fas fa-envelope text-primary me-2 w-25px"></i>
                  <span class="small">@selectedApp.Email</span>
                </div>
                <div class="d-flex align-items-center mb-2">
                  <i class="fas fa-phone text-primary me-2 w-25px"></i>
                  <span class="small">@selectedApp.PhoneNumber</span>
                </div>
                <div class="d-flex align-items-center mb-2">
                  <i class="fas fa-map-marker-alt text-primary me-2 w-25px"></i>
                  <span class="small">@selectedApp.Estate, @selectedApp.County?.Name, @selectedApp.Country?.Name</span>
                </div>
                @if (!string.IsNullOrEmpty(selectedApp.LinkedInProfile))
                {
                  <div class="d-flex align-items-center mb-2">
                    <i class="fab fa-linkedin text-primary me-2 w-25px"></i>
                    <a href="@selectedApp.LinkedInProfile" target="_blank" class="small text-decoration-none">LinkedIn Profile</a>
                  </div>
                }
              </div>

              <hr />

              <h6 class="fw-bold text-uppercase small text-muted mb-3">AI Match Insights</h6>
              <div class="card border-0 shadow-sm rounded-3 mb-3 bg-white">
                <div class="card-body p-3 text-center">
                  <div class="display-6 fw-bold text-primary">@selectedApp.SuitabilityScore%</div>
                  <div class="text-muted small">Match Score</div>
                </div>
              </div>
              <div class="alert alert-primary border-0 rounded-3 small">
                <i class="fas fa-robot me-2"></i><strong>AI Feedback:</strong><br />
                @selectedApp.AIRankingReason
              </div>
              <div class="alert alert-secondary border-0 rounded-3 small mt-3">
                <i class="fas fa-briefcase me-2"></i>
                <strong>Total Experience:</strong> @CalculateTotalExperience(selectedApp) years
              </div>
              <div class="small">
                <strong>Keywords Identified:</strong><br />
                <span class="text-primary italic">@selectedApp.SkillsFound</span>
              </div>
            </div>

            @* Right Column: Cover Letter & History *@
            <div class="col-md-8 p-4 bg-white">

              @* Cover Letter Section *@
              <div class="mb-5">
                <h5 class="fw-bold text-dark border-bottom pb-2 mb-3">
                  <i class="fas fa-file-alt text-primary me-2"></i> Cover Letter / Personal Statement
                </h5>
                <div class="p-3 bg-light rounded-3 small" style="white-space: pre-wrap; line-height: 1.6;">
                  @(string.IsNullOrEmpty(selectedApp.CoverLetter) ? "No cover letter provided." : selectedApp.CoverLetter)
                </div>
              </div>

              @* Experience *@
              <div class="mb-5">
                <h5 class="fw-bold text-dark border-bottom pb-2 mb-3">
                  <i class="fas fa-briefcase text-primary me-2"></i> Work Experience
                </h5>
                @if (selectedApp.Experience != null && selectedApp.Experience.Any())
                {
                  @foreach (var exp in selectedApp.Experience.OrderByDescending(x => x.StartDate))
                  {
                    <div class="mb-4 ps-3 border-start border-2 border-primary">
                      <div class="d-flex justify-content-between align-items-start">
                        <h6 class="fw-bold mb-0">@exp.JobTitle</h6>
                        <span class="badge bg-secondary-subtle text-secondary">
                          @exp.StartDate.ToString("MMM yyyy") - @(exp.EndDate?.ToString("MMM yyyy") ?? "Present")
                        </span>
                      </div>
                      <div class="text-primary small mb-2">@exp.Company | @exp.City, @exp.Country</div>
                      <div class="small text-muted" style="white-space: pre-wrap;">@exp.Responsibilities</div>
                    </div>
                  }
                }
                else
                {
                  <p class="text-muted small italic ps-3">No work experience entries found.</p>
                }
              </div>

              @* Education *@
              <div class="mb-4">
                <h5 class="fw-bold text-dark border-bottom pb-2 mb-3">
                  <i class="fas fa-graduation-cap text-primary me-2"></i> Education
                </h5>
                @if (selectedApp.Education != null && selectedApp.Education.Any())
                {
                  @foreach (var edu in selectedApp.Education.OrderByDescending(x => x.StartDate))
                  {
                    <div class="mb-3 ps-3 border-start border-2 border-info">
                      <div class="d-flex justify-content-between align-items-start">
                        <h6 class="fw-bold mb-0">@edu.Field (@edu.Level)</h6>
                        <span class="small text-muted">@edu.StartDate.Year - @(edu.EndDate?.Year.ToString() ?? "Present")</span>
                      </div>
                      <div class="small text-muted">@edu.Institution | @edu.Country</div>
                    </div>
                  }
                }
                else
                {
                  <p class="text-muted small italic ps-3">No education entries found.</p>
                }
              </div>
            </div>
          </div>
        </div>

        @* Footer Actions *@
        <div class="modal-footer bg-light p-3 border-top d-flex justify-content-between">
          <a href="@($"{PublicBaseUrl}{selectedApp.CVPath}")"
             target="_blank" class="btn btn-outline-dark rounded-pill px-4">
            <i class="fas fa-download me-2"></i> DOWNLOAD ORIGINAL CV
          </a>
          <div class="d-flex gap-2">
            <button class="btn btn-danger rounded-pill px-4 fw-bold shadow-sm" @onclick="() => UpdateStatus(ApplicationStatus.Rejected)">
              <i class="fas fa-times me-2"></i> REJECT
            </button>
            <button class="btn btn-success rounded-pill px-4 fw-bold shadow-sm" @onclick="() => UpdateStatus(ApplicationStatus.Shortlisted)">
              <i class="fas fa-check me-2"></i> SHORTLIST CANDIDATE
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
}
<style>
  .w-25px {
    width: 25px;
    text-align: center;
  }

  .italic {
    font-style: italic;
  }
</style>
@code {
  private List<JobApplication>? applications;
  private JobApplication? selectedApp;
  private string PublicBaseUrl => Config["PublicPortal:BaseUrl"]!;

  protected override async Task OnInitializedAsync()
  {
    await LoadData();
    CheckForAutoOpen();
  }

  private async Task LoadData()
  {
    // Add a method in your service: GetPendingApplicationsAsync()
    applications = await JobAppService.GetApplicationsByStatusAsync(ApplicationStatus.New);
  }

  private void OpenDetails(JobApplication app) => selectedApp = app;

  private async Task UpdateStatus(ApplicationStatus status)
  {
    if (selectedApp == null) return;

    var success = await JobAppService.UpdateApplicationStatusAsync(selectedApp.Id, status);
    if (success)
    {
      var appId = selectedApp.Id;
      selectedApp = null;

      await LoadData(); // refresh "New" list

      if (status == ApplicationStatus.Shortlisted)
      {
        // Navigate to Interview Management for this candidate
        Nav.NavigateTo($"/recruitment/interviews?appId={appId}");
      }
    }
  }
  private void CheckForAutoOpen()
  {
    var uri = Nav.ToAbsoluteUri(Nav.Uri);
    var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);

    if (query.TryGetValue("reviewId", out var reviewIdStr))
    {
      // FIX: Use Guid.TryParse instead of int.TryParse
      if (Guid.TryParse(reviewIdStr, out var id))
      {
        selectedApp = applications?.FirstOrDefault(x => x.Id == id);
      }
    }
  }

  private string GetScoreColor(int score) => score switch
  {
    >= 80 => "bg-success",
    >= 50 => "bg-warning",
    _ => "bg-danger"
  };
  private double CalculateTotalExperience(JobApplication app)
  {
    if (app.Experience == null || !app.Experience.Any())
      return 0;

    double total = 0;

    foreach (var exp in app.Experience)
    {
      var end = exp.EndDate ?? DateTime.UtcNow;
      var years = (end - exp.StartDate).TotalDays / 365.0;
      total += years;
    }

    return Math.Round(total, 1);
  }
}