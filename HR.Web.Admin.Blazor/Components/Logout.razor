@* We do NOT need any @injects or @code blocks here because the form 
    submission bypasses Blazor and hits the server endpoint directly.
*@

<form method="post" action="/logout" class="d-inline">
  <input type="hidden" name="ReturnUrl" value="/login" />

  <button type="submit"
          class="btn btn-outline-danger"
          title="Log Out">
    <i class="fas fa-sign-out-alt me-2"></i> Log Out
  </button>
</form>
