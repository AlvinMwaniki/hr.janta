            </div>
        </div>
    </div>
    @* --- FULL WIDTH SECTION BELOW --- *@
@* --- FULL WIDTH SECTION BELOW --- *@
<div class="row mt-4">
    <div class="col-12">
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-body p-4">
                @* Changed from RecentLeavesWidget to MyApplicationsWidget *@
                <MyApplicationsWidget Applications="myApplications" OnCancel="HandleCancelRequest" />
            </div>
        </div>
    </div>
</div>
    </Authorized>
    <NotAuthorized>
      <p class="alert alert-danger">Access Denied: You Are Not an Employee.</p>
