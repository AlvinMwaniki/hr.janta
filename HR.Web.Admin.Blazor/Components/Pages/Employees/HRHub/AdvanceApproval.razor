@page "/admin/advances"

<div class="container-fluid py-4">
  <nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><a href="/dashboard" class="text-decoration-none text-muted">Tasks Hub</a></li>
      <li class="breadcrumb-item active fw-bold text-primary" aria-current="page">Salary Advances</li>
    </ol>
  </nav>

  <div class="glass-stage shadow-lg border-0 rounded-4 d-flex align-items-center justify-content-center text-center p-5">
    <div class="animate-fade-in">
      <div class="icon-stack mb-4">
        <div class="blob-bg"></div>
        <i class="fas fa-money-check-alt fa-5x text-primary position-relative shadow-icon"></i>
      </div>

      <h2 class="fw-bold text-dark mb-3">Salary Advance Management</h2>
      <p class="text-muted mx-auto mb-4" style="max-width: 500px;">
        We are currently engineering a robust approval workflow for financial requests.
        Soon, you'll be able to review, approve, and track salary advances directly from this hub.
      </p>

      <div class="d-flex justify-content-center gap-3 mb-5">
        <span class="badge rounded-pill bg-light text-dark border p-2 px-3 shadow-sm">
          <i class="fas fa-history me-2 text-info"></i>Repayment Tracking
        </span>
        <span class="badge rounded-pill bg-light text-dark border p-2 px-3 shadow-sm">
          <i class="fas fa-file-invoice-dollar me-2 text-success"></i>Auto-Payroll Sync
        </span>
        <span class="badge rounded-pill bg-light text-dark border p-2 px-3 shadow-sm">
          <i class="fas fa-user-shield me-2 text-warning"></i>Policy Validation
        </span>
      </div>

      <div class="d-grid gap-2 d-sm-flex justify-content-sm-center">
        <a href="/dashboard" class="btn btn-primary btn-lg px-4 gap-3 rounded-pill shadow">
          Back to Dashboard
        </a>
        <button class="btn btn-outline-secondary btn-lg px-4 rounded-pill" disabled>
          <i class="fas fa-bell me-2"></i>Notify Me
        </button>
      </div>
    </div>
  </div>
</div>

