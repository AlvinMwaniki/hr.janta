@page "/help"

<div class="container my-4">
  <h2 class="mb-4">
    <i class="fas fa-question-circle me-2"></i> Help & Support
  </h2>

  <div class="row g-3">
    <!-- FAQ Card -->
    <div class="col-md-6">
      <div class="card shadow-sm h-100">
        <div class="card-body">
          <h5 class="card-title"><i class="fas fa-info-circle me-2"></i> FAQs</h5>
          <p class="card-text">
            Find answers to the most common questions about the HR system.
          </p>
          <NavLink href="/help/faqs" class="btn btn-primary btn-sm">
            View FAQs
          </NavLink>
        </div>
      </div>
    </div>

    <!-- Contact Support Card -->
    <div class="col-md-6">
      <div class="card shadow-sm h-100">
        <div class="card-body">
          <h5 class="card-title"><i class="fas fa-envelope me-2"></i> Contact Support</h5>
          <p class="card-text">
            Need help? Contact our support team for assistance with your account.
          </p>
          <NavLink href="/help/contact" class="btn btn-primary btn-sm">
            Contact Us
          </NavLink>
        </div>
      </div>
    </div>
  </div>

  <!-- Knowledge Base -->
  <div class="card shadow-sm mt-4">
    <div class="card-body">
      <h5 class="card-title"><i class="fas fa-book me-2"></i> Knowledge Base</h5>
      <p class="card-text">
        Browse articles and guides to help you navigate the system and improve productivity.
      </p>
      <NavLink href="/help/knowledgebase" class="btn btn-outline-primary btn-sm">
        Explore Articles
      </NavLink>
    </div>
  </div>
</div>
