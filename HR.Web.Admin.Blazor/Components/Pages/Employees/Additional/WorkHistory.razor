@page "/employees/workhistory"
@using HR.Data
@using DataModels = HR.Data.Models.Employees 
@using Microsoft.EntityFrameworkCore
@using HR.Services.Services
@inject EmployeeTempService TempService
@inject NavigationManager Navigation
@rendermode InteractiveServer 
@using Microsoft.AspNetCore.Components.Forms
@inject IJSRuntime JSRuntime

<h3>Step 3: Work History</h3>

@* 1. Use EditContext parameter instead of Model *@
<EditForm EditContext="@editContext" OnValidSubmit="AddOrUpdateWork" FormName="Step3">
  <DataAnnotationsValidator />
  <Microsoft.AspNetCore.Components.Forms.ValidationSummary />

  <div class="form-card">
    <!-- Row 1: Job Title, Company Name -->
    <div class="row mb-2">
      <div class="col-md-6">
        <label class="form-label">Job Title</label>
        <InputText @bind-Value="workModel.JobTitle" class="form-control" />
        <ValidationMessage For="@(() => workModel.JobTitle)" />
      </div>
      <div class="col-md-6">
        <label class="form-label">Company Name</label>
        <InputText @bind-Value="workModel.CompanyName" class="form-control" />
        <ValidationMessage For="@(() => workModel.CompanyName)" />
      </div>
    </div>

    <!-- Row 2: City, Country -->
    <div class="row mb-2">
      <div class="col-md-6">
        <label class="form-label">City</label>
        <InputText @bind-Value="workModel.CompanyCity" class="form-control" />
        <ValidationMessage For="@(() => workModel.CompanyCity)" />

      </div>
      <div class="col-md-6">
        <label class="form-label">Country</label>
        <InputText @bind-Value="workModel.CompanyCountry" class="form-control" />
        <ValidationMessage For="@(() => workModel.CompanyCountry)" />

      </div>
    </div>
    
    <!-- Row 3: Job Duties -->
    <div class="row mb-2">
      <div class="col-md-12">
        <label class="form-label">Job Duties</label>
        <InputTextArea @bind-Value="workModel.JobDuties" class="form-control" />
        <ValidationMessage For="@(() => workModel.JobDuties)" />
      </div>
    </div>

    <!-- Row 4: From Date, To Date -->
    <div class="row mb-2">
      <div class="col-md-6">
        <label class="form-label">From Date</label>
        <InputDate @bind-Value="workModel.JobFromDate" class="form-control" />
        <ValidationMessage For="@(() => workModel.JobFromDate)" />

      </div>
      <div class="col-md-6">
        <label class="form-label">To Date</label>
        <InputDate @bind-Value="workModel.JobToDate" class="form-control" />
        <ValidationMessage For="@(() => workModel.JobToDate)" />

      </div>
    </div>

    <!-- Current Job Checkbox -->
    <div class="row mb-3">
      <div class="col-md-12">
        <div class="form-check">
          <InputCheckbox @bind-Value="workModel.IsCurrentJob" class="form-check-input" />
          <label class="form-check-label ms-2">Current Job</label>
        </div>
      </div>
    </div>

    <div class="mt-3">
      <button type="submit" class="btn btn-primary px-4 shadow-sm">
        <i class="fas @(editingWorkIndex >= 0 ? "fa-save" : "fa-plus") me-2"></i>
        @((editingWorkIndex >= 0) ? "Update" : "Add WorkHistory")
    </button>
      @* Show BACK button here ONLY if no education has been added yet *@
      @if (!TempService.TempEmployee.WorkHistory.Any())
      {
        <button type="button" class="btn btn-outline-secondary ms-2" @onclick="GoBack">Back</button>
      }
    </div>
  </div>
</EditForm>

@* --- List existing items directly from the Service's list --- *@
@if (TempService.TempEmployee.WorkHistory.Any())
{
  <div class="card shadow-sm border-0 mt-5 overflow-hidden" style="border-radius: 12px;">
    <div class="table-responsive">
      <table class="table table-hover mb-0">
        <thead style="background-color: #222240; color: white;">
      <tr>
            <th class="ps-4 py-3" style="background-color: #222240; color: white;">Job Title</th>
            <th class="py-3" style="background-color: #222240; color: white;">Company</th>
            <th class="py-3" style="background-color: #222240; color: white;">From</th>
            <th class="py-3" style="background-color: #222240; color: white;">To</th>
            <th class="py-3" style="background-color: #222240; color: white;">Current</th>
            <th class="py-3" style="background-color: #222240; color: white;">Actions</th>
      </tr>
    </thead>
    <tbody>
      @for (int i = 0; i < TempService.TempEmployee.WorkHistory.Count; i++)
      {
        var work = TempService.TempEmployee.WorkHistory[i];
        <tr>
          <td>@work.JobTitle</td>
          <td>@work.CompanyName</td>
          <td>@work.JobFromDate.ToShortDateString()</td>
          <td>@work.JobToDate.ToShortDateString()</td>
          <td>@(work.IsCurrentJob ? "Yes" : "No")</td>
          <td>
            <button class="btn btn-sm btn-warning me-1" @onclick="() => EditWork(work)">Edit</button>
            <button class="btn btn-sm btn-danger" @onclick="() => DeleteWork(work)">Delete</button>
          </td>
        </tr>
      }
    </tbody>
  </table>
    </div>
  </div>
  <div class="d-flex justify-content-between mt-4 pb-5">
    <button class="btn btn-secondary me-2" @onclick="GoBack">
      <i class="fas fa-arrow-left me-2"></i> Back
    </button>
    <button class="btn btn-success" @onclick="NextStep">
      Next <i class="fas fa-arrow-right ms-2"></i>
    </button>
  </div>
}

@code {
  // Use the alias when declaring the model type
  private DataModels.WorkHistory workModel = new();
  private int editingWorkIndex = -1;
  private EditContext? editContext;

  protected override void OnInitialized()
  {
    editContext = new EditContext(workModel)!;
    workModel.JobFromDate = DateTime.Today;
    workModel.JobToDate = DateTime.Today;
  }

  private async Task AddOrUpdateWork(EditContext context)
  {
    if (editingWorkIndex >= 0)
    {
      TempService.UpdateWork(editingWorkIndex, workModel);
      editingWorkIndex = -1;
    }
    else
    {
      TempService.AddWork(workModel);
    }

    // Use alias when resetting the model
    workModel = new DataModels.WorkHistory(); 
    editContext = new EditContext(workModel)!;
    StateHasChanged(); 
    await Task.Delay(100);
    await JSRuntime.InvokeVoidAsync("scrollToBottom");

  }

  // CHANGE: Accepts the WorkHistory object, not the index
  private void EditWork(DataModels.WorkHistory itemToEdit)
  {
    // CRITICAL: Find the index of the object passed in
    int index = TempService.TempEmployee.WorkHistory.IndexOf(itemToEdit);

    if (index == -1) return; // Safely exit if the item is somehow missing

    // Create a deep copy from the item passed in
    workModel = new DataModels.WorkHistory
    {
      Id = itemToEdit.Id,
      EmployeeId = itemToEdit.EmployeeId,
      JobTitle = itemToEdit.JobTitle,
      CompanyName = itemToEdit.CompanyName,
      CompanyCity = itemToEdit.CompanyCity,
      CompanyCountry = itemToEdit.CompanyCountry,
      JobDuties = itemToEdit.JobDuties,
      JobFromDate = itemToEdit.JobFromDate,
      JobToDate = itemToEdit.JobToDate,
      IsCurrentJob = itemToEdit.IsCurrentJob
    };

    editingWorkIndex = index; // Use the found index for update tracking
    editContext = new EditContext(workModel)!;
    StateHasChanged();
  }

  // CHANGE: Accepts the WorkHistory object, not the index

  private void DeleteWork(DataModels.WorkHistory itemToDelete)
  {
    // CRITICAL: Find the index of the object passed in
    int index = TempService.TempEmployee.WorkHistory.IndexOf(itemToDelete);

    if (index == -1) return; // Safely exit

    // Remove the item using the found index
    TempService.RemoveWork(index);

    editingWorkIndex = -1;
    // Reset form for next input
    workModel = new DataModels.WorkHistory();
    editContext = new EditContext(workModel)!;
    StateHasChanged();
  }
  
  private void GoBack()
  {
    Navigation.NavigateTo("/employees/additional");
    StateHasChanged();
  }

  private void NextStep()
  {
    Navigation.NavigateTo($"/employees/additional/nextofkin");
    StateHasChanged();
  }
}
