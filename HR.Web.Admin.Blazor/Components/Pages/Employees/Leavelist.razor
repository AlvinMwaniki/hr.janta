@page "/employees/leaves"
@using HR.Core.Enums
@using HR.Services.DTO
@using HR.Services.Interfaces
@inject ILeaveService LeaveService
@inject IJSRuntime JS
@rendermode InteractiveServer

<div class="container-fluid py-4 min-vh-100">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold prox-header-text mb-0">MASTER LEAVE RECORDS</h2>
    <div class="text-muted small">Total Records: @filteredRequests?.Count</div>
  </div>

  @* --- COMPACT FILTER BAR --- *@
  <div class="card form-card mb-4 border-0">
    <div class="card-body p-3">
      <div class="row g-3">
        <div class="col-md-3">
          <label class="form-label x-small fw-bold text-muted text-uppercase">Status</label>
          <select class="form-select form-select-sm border-light" @bind="selectedStatus">
            <option value="">All Statuses</option>
            @foreach (LeaveStatus status in Enum.GetValues(typeof(LeaveStatus)))
            {
              <option value="@status">@status</option>
            }
          </select>
        </div>
        <div class="col-md-3">
          <label class="form-label x-small fw-bold text-muted text-uppercase">Leave Type</label>
          <select class="form-select form-select-sm border-light" @bind="selectedType">
            <option value="">All Types</option>
            @foreach (LeaveType type in Enum.GetValues(typeof(LeaveType)))
            {
              <option value="@type">@type</option>
            }
          </select>
        </div>
        <div class="col-md-4">
          <label class="form-label x-small fw-bold text-muted text-uppercase">Department</label>
          <select class="form-select form-select-sm border-light shadow-none" @bind="selectedDept">
            <option value="">All Departments</option>
            @foreach (DepartmentType dept in Enum.GetValues(typeof(DepartmentType)))
            {
              <option value="@dept">@dept</option>
            }
          </select>
        </div>
        <div class="col-md-2 d-flex align-items-end">
          <button class="btn btn-outline-primary btn-sm w-100 fw-bold border-2 rounded-pill shadow-sm"
                  @onclick="ApplyFilters"
                  style="transition: all 0.3s ease; height: 38px;">
            <i class="fas fa-search me-2"></i> FILTER
          </button>
        </div>
      </div>
    </div>
  </div>

  @* --- UNIFORM DATA TABLE --- *@
  <div class="card form-card border-0 overflow-hidden p-0">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0 custom-staff-table">
        <thead class="table-primary text-white">
        <tr>
          <th class="ps-4">Employee</th>
          <th>Type</th>
          <th>Duration</th>
          <th>Status</th>
          <th class="text-end pe-4">Details</th>
        </tr>
      </thead>
      <tbody>
        @if (filteredRequests != null)
        {
          @foreach (var req in filteredRequests)
          {
            <tr>
              <td class="ps-4">
                <div class="fw-bold prox-header-text">@req.EmployeeName</div>
                <div class="text-muted x-small">@req.Department</div>
              </td>
              <td>
                <span class="badge border border-primary text-primary prox-badge-outline fw-normal" style="width: 100px; display: inline-block;">@req.LeaveType</span>
              </td>
              <td>
                <div class="fw-bold">@req.DurationInDays Days</div>
                <div class="text-muted x-small">@req.FromDate.ToString("MMM dd, yyyy")</div>
              </td>
              <td>
                @{
                    var statusClass = req.Status == LeaveStatus.Approved ? "bg-success text-white" : req.Status == LeaveStatus.Rejected ? "bg-danger text-white" : "bg-warning text-white";
                }
                <span class="badge @statusClass-subtle text-@statusClass.Replace("bg-", "") d-inline-block text-center" style="width: 100px;">@req.Status.ToString().ToUpper()</span>
              </td>
              <td class="text-end pe-4">
                <button class="btn btn-sm btn-outline-primary rounded-pill px-3" @onclick="() => ShowDetails(req)">View</button>
              </td>
            </tr>
          }
        }
      </tbody>
    </table>
  </div>
</div>
</div>

@* --- RE-ORDERED MODAL (SAME AS ADMIN) --- *@
@if (selectedRequest != null)
{
  <div class="modal fade show d-block" style="background: rgba(0,0,0,0.5); backdrop-filter: blur(4px);">
    <div class="modal-dialog modal-lg modal-dialog-centered">
      <div class="modal-content border-0 shadow-lg rounded-4">
        <div class="modal-header border-bottom-0 p-4">
          <h5 class="modal-title fw-bold text-uppercase">Official Application Detail</h5>
          <button type="button" class="btn-close" @onclick="CloseDetails"></button>
        </div>

        <div id="printArea" class="modal-body p-5 pt-0">
          <div class="d-none d-print-block text-center mb-4">
            <h2 class="fw-bold text-dark">HR MASTER PROX</h2>
            <h5 class="text-muted">Official Leave Request Form</h5>
            <hr />
          </div>

          <div class="row g-4">
            <div class="col-7">
              <small class="text-muted d-block text-uppercase fw-bold x-small mb-1">Employee Name</small>
              <div class="fs-5 fw-bold">@selectedRequest.EmployeeName</div>
            </div>
            <div class="col-5 text-end">
              <small class="text-muted d-block text-uppercase fw-bold x-small mb-1">Application Date</small>
              <div class="fw-semibold">@selectedRequest.CreatedAt.ToString("MMMM dd, yyyy")</div>
            </div>

            <div class="col-6">
              <small class="text-muted d-block text-uppercase fw-bold x-small mb-1">Department</small>
              <div class="fw-bold text-dark">@(string.IsNullOrEmpty(selectedRequest.Department) ? "Not Assigned" : selectedRequest.Department)</div>
            </div>
            <div class="col-6">
              <small class="text-muted d-block text-uppercase fw-bold x-small mb-1">Job Title</small>
              <div class="fw-bold text-dark">@(string.IsNullOrEmpty(selectedRequest.EmployeeJobTitle) ? "Not Assigned" : selectedRequest.EmployeeJobTitle)</div>
            </div>

            <div class="col-4">
              <small class="text-muted d-block text-uppercase fw-bold x-small mb-1">Leave Type</small>
              <span class="badge bg-primary px-3">@selectedRequest.LeaveType</span>
            </div>
            <div class="col-8 text-end">
              <small class="text-muted d-block text-uppercase fw-bold x-small mb-1">Leave Period</small>
              <div class="fw-bold">@selectedRequest.FromDate.ToLongDateString() — @selectedRequest.ToDate.ToLongDateString()</div>
            </div>

            <div class="col-12 border-top pt-3">
              <small class="text-muted d-block text-uppercase fw-bold x-small mb-1">Duration</small>
              <div class="h4 fw-bold text-primary">@selectedRequest.DurationInDays Days</div>
            </div>

            <div class="col-12 mt-4">
              <div class="p-4 bg-light border rounded-3" style="font-family: serif; min-height: 150px;">
                <label class="small fw-bold text-uppercase text-muted border-bottom w-100 mb-3 pb-1">Statement of Reason</label>
                <p class="fs-5 mb-0" style="white-space: pre-wrap; line-height: 1.6;">@selectedRequest.Reason</p>
              </div>
            </div>
          </div>

          <div class="d-none d-print-block mt-5 pt-5">
            <div class="row mt-5">
              <div class="col-6"><div class="border-top pt-2 text-center small fw-bold">Employee Signature</div></div>
              <div class="col-6"><div class="border-top pt-2 text-center small fw-bold">Authorized Approval</div></div>
            </div>
          </div>
        </div>

        <div class="modal-footer border-top-0 p-4">
          <button class="btn btn-dark fw-bold px-4 me-auto" onclick="window.print()">
            <i class="fas fa-print me-2"></i> PRINT TO A4
          </button>
          <button class="btn btn-secondary px-4" @onclick="CloseDetails">Close</button>
        </div>
      </div>
    </div>
  </div>
}

<style>
  .x-small {
    font-size: 0.75rem;
  }

  @@media print {
    body * {
      visibility: hidden;
    }

    #printArea, #printArea * {
      visibility: visible;
    }

    #printArea {
      position: fixed; /* Fixed prevents the "way below" issue */
      left: 0;
      top: 0;
      width: 100%;
      padding: 20px;
      margin: 0;
    }

    .modal-footer, .btn-close {
      display: none !important;
    }
  }
</style>

@code {
  private List<LeaveRequestViewDto>? allRequests;
  private List<LeaveRequestViewDto>? filteredRequests;
  private string selectedStatus = "";
  private string selectedType = "";
  private string selectedDept = "";
  private LeaveRequestViewDto? selectedRequest;

  protected override async Task OnInitializedAsync() => await LoadData();
  private async Task LoadData() { allRequests = await LeaveService.GetAllRequestsAsync(); filteredRequests = allRequests; }
  private void ShowDetails(LeaveRequestViewDto req) => selectedRequest = req;
  private void CloseDetails() => selectedRequest = null;
  private void ApplyFilters()
  {
    filteredRequests = allRequests?.Where(r =>
        (string.IsNullOrEmpty(selectedStatus) || r.Status.ToString() == selectedStatus) &&
        (string.IsNullOrEmpty(selectedType) || r.LeaveType.ToString() == selectedType) &&
        (string.IsNullOrEmpty(selectedDept) || r.Department.Contains(selectedDept, StringComparison.OrdinalIgnoreCase))
    ).ToList();
  }
}