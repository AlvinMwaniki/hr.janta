@inherits LayoutComponentBase

<div class="public-portal">
  @* A clean header with your logo *@
  <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm py-3">
    <div class="container">
      <a class="navbar-brand fw-bold text-primary" href="/">
        <i class="bi bi-rocket-takeoff-fill me-2"></i> HR CAREERS
      </a>
      <div class="ms-auto">
        <span class="text-muted small">Open Positions</span>
      </div>
    </div>
  </nav>

  <main class="container py-5">
    <article class="content">
      @Body
    </article>
  </main>

  <footer class="bg-light py-4 mt-5 border-top">
    <div class="container text-center">
      <p class="text-muted mb-0">&copy; @DateTime.Now.Year - Join Our Team</p>
    </div>
  </footer>
</div>

<div id="blazor-error-ui" data-nosnippet>
  An unhandled error has occurred.
  <a href="." class="reload">Reload</a>
  <span class="dismiss">🗙</span>
</div>

<style>
  /* Remove the default Blazor sidebar styling for this project */
  .page {
    display: block !important;
  }

  .sidebar {
    display: none !important;
  }

  .public-portal {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  main {
    flex: 1;
  }
</style>