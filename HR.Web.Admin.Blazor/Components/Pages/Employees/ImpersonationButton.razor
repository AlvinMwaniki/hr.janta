@using Microsoft.AspNetCore.Components.Authorization
@using HR.Services.Services
@using HR.Services.Constants
@using System.Threading.Tasks
@using Microsoft.AspNetCore.Authorization
@inject NavigationManager Navigation
@inject ImpersonationService Impersonation

@rendermode InteractiveServer
@attribute [Authorize]

<AuthorizeView Policy="@AppPermissions.CanImpersonate">
  <Authorized>
    <div class="logout-container">
      <button @onclick="ToggleImpersonation" class="btn btn-sm btn-warning me-4">
        <i class="fas fa-exchange-alt me-1"></i>
        @(Impersonation.IsImpersonating ? "Exit Employee View" : "Employee View")
      </button>
    </div>
  </Authorized>
</AuthorizeView>

@code {
  protected override void OnInitialized()
  {
    // Subscribe to the service event to update button text
    Impersonation.ImpersonationStateChanged += OnImpersonationStateChanged;
  }

  private void OnImpersonationStateChanged()
  {
    // Force the button/component to re-render
    InvokeAsync(StateHasChanged);
  }

  // IMPORTANT: We need IDisposable to clean up the event subscription.
  // If you are using a class definition (e.g., ImpersonationButton : ComponentBase, IDisposable)
  // you need the Dispose method. If not, add the interface and method:

  // public void Dispose()
  // {
  //     Impersonation.ImpersonationStateChanged -= OnImpersonationStateChanged;
  // }

  private void ToggleImpersonation()
  {
    // 1. Service toggles state and raises event.
    Impersonation.ToggleImpersonation();

    // 2. Component navigates, forcing the Dashboard to reload its data.
    // This is safe here because this component is interactive.
    Navigation.NavigateTo("/dashboard", forceLoad: true);
  }
}