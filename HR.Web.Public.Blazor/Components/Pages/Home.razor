@page "/"

<PageTitle>HR Master Prox | Professional HR Management</PageTitle>

<div class="landing-wrapper">
  <section class="hero-section text-center text-white d-flex align-items-center justify-content-center">
    <div class="hero-overlay"></div> @* Dark overlay for text readability *@
    <div class="container py-5 position-relative z-index-1">
      <div class="badge-pill mb-3">Next-Gen HR Management</div>
      <h1 class="display-3 fw-bold mb-3 animate__animated animate__fadeInDown">
        Streamline Your People <span class="text-primary-accent-light">Operations</span>
      </h1>
      <p class="lead mx-auto mb-5 animate__animated animate__fadeInUp" style="max-width: 700px;">
        Experience a seamless journey from recruitment to retirement. HR Master Prox simplifies complex workflows so you can focus on what matters most—your people.
      </p>
      <div class="d-flex justify-content-center gap-3 animate__animated animate__fadeInUp animate__delay-1s">
        <a href="/jobs" class="btn btn-primary-gradient btn-lg px-5 shadow-lg">View Openings</a>
        <a href="/about" class="btn btn-outline-light btn-lg px-5 border-2">Learn More</a>
      </div>
    </div>
  </section>

  <section class="stats-section py-5 bg-light-soft">
    <div class="container">
      <div class="text-center mb-5">
        <h2 class="fw-bold text-navy">Why Choose HR Master Prox?</h2>
        <div class="accent-bar mx-auto"></div>
      </div>
      <div class="row text-center g-4">
        <div class="col-md-4">
          <div class="stat-item p-4 rounded-3 bg-white shadow-sm border">
            <i class="bi bi-people-fill text-primary-accent fs-2 mb-3"></i>
            <h3 class="display-5 fw-bold text-navy">1000+</h3>
            <p class="lead text-muted mb-0">Employees Managed</p>
          </div>
        </div>
        <div class="col-md-4">
          <div class="stat-item p-4 rounded-3 bg-white shadow-sm border">
            <i class="bi bi-check-circle-fill text-success fs-2 mb-3"></i>
            <h3 class="display-5 fw-bold text-navy">99%</h3>
            <p class="lead text-muted mb-0">Payroll Accuracy</p>
          </div>
        </div>
        <div class="col-md-4">
          <div class="stat-item p-4 rounded-3 bg-white shadow-sm border">
            <i class="bi bi-clock-fill text-warning fs-2 mb-3"></i>
            <h3 class="display-5 fw-bold text-navy">75%</h3>
            <p class="lead text-muted mb-0">Time Saved</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="container py-5">
    <div class="text-center mb-5">
      <h2 class="fw-bold text-navy">The HR Master Prox Lifecycle</h2>
      <div class="accent-bar mx-auto"></div>
    </div>

    <div class="row g-4">
      <div class="col-md-4">
        <div class="process-card shadow-sm">
          <img src="/images/recruitment.webp" alt="Recruitment Process" class="process-img mb-4">
          <h4>Recruitment & Onboarding</h4>
          <p>AI-powered CV parsing, automated job requisitions, and smooth onboarding for new hires.</p>
        </div>
      </div>

      <div class="col-md-4">
        <div class="process-card shadow-sm">
          <img src="/images/management.webp" alt="Employee Management" class="process-img mb-4">
          <h4>Employee Management</h4>
          <p>Comprehensive digital profiles, contract tracking, and sub-county localized data management.</p>
        </div>
      </div>

      <div class="col-md-4">
        <div class="process-card shadow-sm">
          <img src="/images/payroll.webp" alt="Payroll & Benefits" class="process-img mb-4">
          <h4>Payroll & Compliance</h4>
          <p>Automated tax calculations, benefit distributions, and secure payment processing with compliance assurance.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="call-to-action-section text-center text-white py-5">
    <div class="container">
      <h2 class="display-4 fw-bold mb-3">Ready to Transform Your HR?</h2>
      <p class="lead mx-auto mb-4" style="max-width: 600px;">
        Join hundreds of businesses leveraging HR Master Prox for smarter, faster, and more efficient human resource management.
      </p>
      <a href="/contact" class="btn btn-light btn-lg px-5 shadow-lg fw-bold">Get a Demo Today</a>
    </div>
  </section>
</div>

@* Link to Bootstrap Icons for the new icons *@
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
@* Optional: Animate.css for subtle entrance animations (npm install animate.css or CDN) *@
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />

<style>
  /* Global Variables and Base Styles */
  :root {
    --text-navy: #222240;
    --primary-accent: #0d6efd;
    --primary-accent-light: #66aaff; /* Lighter shade for contrast */
    --bg-light-soft: #f8faff; /* Very light blueish background */
  }

  .text-navy {
    color: var(--text-navy) !important;
  }

  .text-primary-accent {
    color: var(--primary-accent) !important;
  }

  .text-primary-accent-light {
    color: var(--primary-accent-light) !important;
  }

  .bg-light-soft {
    background-color: var(--bg-light-soft);
  }

  .landing-wrapper {
    font-family: 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  }

  /* Hero Section */
  .hero-section {
    position: relative;
    height: 550px; /* Adjust height as needed */
    background: url('/images/hero-bg.webp') no-repeat center center;
    background-size: cover; /* Correct way to set background image scaling */
    overflow: hidden;
  }

  .hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(34, 34, 64, 0.75); /* Darker overlay for text contrast */
  }

  .hero-section .container {
    position: relative;
    z-index: 10;
  }

  .hero-section h1 {
    font-size: 3.8rem;
    line-height: 1.2;
  }

  .hero-section p {
    font-size: 1.25rem;
    font-weight: 300;
    opacity: 0.9;
  }

  .badge-pill {
    display: inline-block;
    padding: 8px 22px;
    background: rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(5px);
    border: 1px solid rgba(255, 255, 255, 0.3);
    color: white;
    border-radius: 50px;
    font-weight: 600;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 20px;
  }

  .btn-primary-gradient {
    background: linear-gradient(45deg, var(--primary-accent), #0056b3);
    color: white;
    border: none;
    border-radius: 12px;
    padding: 14px 30px;
    font-weight: bold;
    transition: all 0.3s ease;
  }

    .btn-primary-gradient:hover {
      transform: translateY(-3px);
      box-shadow: 0 10px 20px rgba(13, 110, 253, 0.3);
      background: linear-gradient(45deg, #0056b3, var(--primary-accent)); /* Subtle hover gradient shift */
      color: white;
    }

  .btn-outline-light {
    border-radius: 12px;
    padding: 14px 30px;
    font-weight: bold;
    transition: all 0.3s ease;
  }

    .btn-outline-light:hover {
      background-color: rgba(255,255,255,0.1);
      transform: translateY(-3px);
      box-shadow: 0 10px 20px rgba(255,255,255,0.1);
    }


  /* Accent Bar */
  .accent-bar {
    width: 80px;
    height: 5px;
    background: var(--primary-accent);
    border-radius: 10px;
    margin-top: 10px;
  }

  /* Statistics Section */
  .stats-section {
    background-color: var(--bg-light-soft);
    padding: 70px 0;
  }

  .stat-item {
    transition: all 0.3s ease;
    border-radius: 15px !important;
  }

    .stat-item:hover {
      transform: translateY(-8px);
      box-shadow: 0 12px 25px rgba(0,0,0,0.08) !important;
    }

    .stat-item i {
      font-size: 2.8rem !important;
    }

    .stat-item h3 {
      font-size: 3rem !important;
      line-height: 1.2;
    }

    .stat-item p {
      font-size: 1.1rem;
      opacity: 0.8;
    }


  /* Process Cards */
  .process-card {
    background: white;
    border-radius: 20px;
    padding: 35px;
    text-align: center;
    border: 1px solid rgba(0,0,0,0.05);
    transition: all 0.3s ease;
    height: 100%;
  }

    .process-card:hover {
      transform: translateY(-10px);
      box-shadow: 0 20px 40px rgba(34, 34, 64, 0.12) !important;
    }

    .process-card h4 {
      font-weight: bold;
      color: var(--text-navy);
      margin-bottom: 15px;
      font-size: 1.5rem;
    }

    .process-card p {
      font-size: 1rem;
      color: #666;
    }

  .process-img {
    width: 100%; /* Ensure images fill their container */
    max-width: 250px; /* Limit size for visual appeal */
    height: auto;
    border-radius: 10px;
    object-fit: cover; /* Cover the area without distortion */
    box-shadow: 0 5px 15px rgba(0,0,0,0.05);
  }

  /* Call to Action Section */
  .call-to-action-section {
    background: linear-gradient(90deg, #222240 0%, #3a3a60 100%);
    padding: 80px 0;
    border-top: 5px solid var(--primary-accent);
  }

    .call-to-action-section h2 {
      font-size: 2.8rem;
    }

    .call-to-action-section p {
      font-size: 1.2rem;
      opacity: 0.9;
    }

  /* Dark Mode Adjustments */
  [data-bs-theme='dark'] .hero-section {
    background: url('/images/hero-bg-dark.webp') no-repeat center center;
    background-size: cover;
  }

  [data-bs-theme='dark'] .hero-overlay {
    background: rgba(0,0,0,0.85);
  }

  [data-bs-theme='dark'] .badge-pill {
    background: rgba(255,255,255,0.1);
    border-color: rgba(255,255,255,0.15);
  }

  [data-bs-theme='dark'] .text-navy {
    color: #e0e7ed !important;
  }

  [data-bs-theme='dark'] .bg-light-soft {
    background-color: #1a1a1a;
  }

  [data-bs-theme='dark'] .stat-item, [data-bs-theme='dark'] .process-card {
    background: #2d2d2d !important;
    border-color: #3a3a3a !important;
  }

    [data-bs-theme='dark'] .stat-item p, [data-bs-theme='dark'] .process-card p {
      color: #bbbbbb;
    }

</style>