@page "/set-password"

@using HR.Web.Admin.Blazor.Models
@using HR.Services.Services 
@using HR.Utilities
@inject IAuthService AuthService
@inject NavigationManager Navigation

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-lg mt-5">
            <div class="card-header bg-primary text-white text-center">
                <h4>Set Your New Password</h4>
            </div>
            <div class="card-body p-4">

                @if (pageState == PageState.Loading)
                {
                    <p class="text-center">Validating setup link...</p>
                    <div class="spinner-border text-primary d-block mx-auto"></div>
                }
                else if (pageState == PageState.Invalid)
                {
                    <div class="alert alert-danger">
                        The setup link is **invalid** or has **expired**. Please contact administration.
                    </div>
                }
                else if (pageState == PageState.Success)
                {
                    <div class="alert alert-success">
                        Password set successfully! You can now log in with your email and new password.
                    </div>
                    <button class="btn btn-primary d-block w-100" @onclick="GoToLogin">Go to Login</button>
                }
                else if (pageState == PageState.Ready)
                {
                    <EditForm Model="@model" OnValidSubmit="@HandleSetPassword">
                        <DataAnnotationsValidator />
                        
                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div class="alert alert-danger">@errorMessage</div>
                        }

                        <div class="mb-3">
                            <label for="newPassword" class="form-label">New Password</label>
                            @* Use @bind-Value:after to trigger strength check after input changes *@
                            <InputText id="newPassword" @bind-Value="model.NewPassword" @bind-Value:after="CheckPasswordStrength" type="password" class="form-control" />
                            <ValidationMessage For="@(() => model.NewPassword)" />
                            
                            @* Password Strength Indicator UI *@
                            <div class="progress mt-1" style="height: 5px;">
                                <div class="progress-bar @StrengthCssClass" role="progressbar" 
                                     style="width: @StrengthPercentage%;" 
                                     aria-valuenow="@StrengthScore" aria-valuemin="0" aria-valuemax="3">
                                </div>
                            </div>
                            <small class="text-@StrengthTextColor">@StrengthText</small>
                        </div>

                        <div class="mb-3">
                            <label for="confirmPassword" class="form-label">Confirm Password</label>
                            <InputText id="confirmPassword" @bind-Value="model.ConfirmPassword" type="password" class="form-control" />
                            <ValidationMessage For="@(() => model.ConfirmPassword)" />
                        </div>

                        <div class="d-grid">
                            @* Only allow submit if password is at least Moderate strength *@
                            <button type="submit" class="btn btn-primary" disabled="@isBusy || currentStrength < PasswordStrength.Moderate">
                                @if (isBusy) { <span class="spinner-border spinner-border-sm me-2"></span> }
                                Set Password
                            </button>
                        </div>
                         @if (currentStrength < PasswordStrength.Moderate)
                         {
                             <div class="text-danger mt-2 text-center">Password must be at least Moderate strength.</div>
                         }
                    </EditForm>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private enum PageState { Loading, Ready, Invalid, Success }
    
    [SupplyParameterFromQuery]
    [Parameter]
    public string? Token { get; set; }

    private SetPasswordModel model = new SetPasswordModel();
    private PageState pageState = PageState.Loading;
    private string? errorMessage;
    private bool isBusy;
    private Guid userId = Guid.Empty;

    // --- Password Strength Properties ---
    private PasswordStrength currentStrength = PasswordStrength.Invalid;
    private int StrengthScore => (int)currentStrength;
    private int StrengthPercentage => currentStrength switch 
    {
        PasswordStrength.Strong => 100,
        PasswordStrength.Moderate => 66,
        PasswordStrength.Weak => 33,
        _ => 0
    };

    private string StrengthCssClass => currentStrength switch
    {
        PasswordStrength.Strong => "bg-success",
        PasswordStrength.Moderate => "bg-warning",
        PasswordStrength.Weak => "bg-danger",
        _ => "bg-light" 
    };

    private string StrengthTextColor => currentStrength switch
    {
        PasswordStrength.Strong => "success",
        PasswordStrength.Moderate => "warning",
        PasswordStrength.Weak => "danger",
        _ => "secondary"
    };

    private string StrengthText => currentStrength switch
    {
        PasswordStrength.Strong => "Strong Password",
        PasswordStrength.Moderate => "Moderate Password",
        PasswordStrength.Weak => "Weak Password",
        _ => "Please enter a password (min 8 characters)"
    };
    
    // --- Lifecycle and Initialization ---
    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrEmpty(Token))
        {
            pageState = PageState.Invalid;
            return;
        }

        model.Token = Token!;
        
        var validationResult = await AuthService.ValidateSetupTokenAsync(Token!);

        if (validationResult.Success)
        {
            userId = validationResult.UserId;
            pageState = PageState.Ready;
        }
        else
        {
            pageState = PageState.Invalid;
        }
    }
    
    // --- Strength Check Method ---
    private void CheckPasswordStrength()
    {
        currentStrength = PasswordStrengthChecker.Check(model.NewPassword);
        // Note: StateHasChanged is handled by @bind-Value:after
    }

    // --- Form Submission ---
    private async Task HandleSetPassword()
    {
        isBusy = true;
        errorMessage = null;

        if (currentStrength < PasswordStrength.Moderate)
        {
            errorMessage = "The password strength is too low. Please choose a stronger password.";
            isBusy = false;
            return;
        }

        try
        {
            await AuthService.SetNewPasswordAsync(userId, model.NewPassword);
            pageState = PageState.Success;
        }
        catch (Exception)
        {
            errorMessage = "An error occurred while setting the password. Please try again or contact support.";
            pageState = PageState.Ready; 
        }
        finally
        {
            isBusy = false;
        }
    }

    private void GoToLogin()
    {
        Navigation.NavigateTo("/login");
    }
}