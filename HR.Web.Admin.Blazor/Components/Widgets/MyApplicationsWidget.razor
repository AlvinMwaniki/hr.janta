@using HR.Core.Enums
@using HR.Services.DTO
@using HR.Services.Interfaces
@inject ILeaveService LeaveService

@* MyApplicationsWidget.razor *@
<div class="d-flex justify-content-between align-items-center mb-4">
  <h5 class="mb-0 text-dark"><i class="fas fa-stream me-2 text-primary"></i> My Recent Applications</h5>
</div>

<div class="table-responsive">
  <table class="table align-middle">
    <thead class="text-secondary small text-uppercase bg-light">
      <tr>
        <th class="ps-3">Category</th>
        <th>Request Detail</th>
        <th class="text-center">Applied Date</th>
        <th>Status</th>
        <th class="text-end pe-3">Action</th>
      </tr>
    </thead>
    <tbody>
      @foreach (var app in Applications)
      {
        <tr>
          <td class="ps-3">
            @if (app.RequestType == "Leave")
            {
              <span class="badge bg-info-subtle text-info border-info-subtle border"><i class="fas fa-calendar-alt me-1"></i> Leave</span>
            }
            else
            {
              <span class="badge bg-success-subtle text-success border-success-subtle border"><i class="fas fa-hand-holding-usd me-1"></i> Advance</span>
            }
          </td>
          <td>
            <div class="fw-bold">@app.Description</div>
            <div class="small text-muted">@app.Detail</div>
          </td>
          <td class="text-center small">@app.Date.ToShortDateString()</td>
          <td>
            <span class="badge @GetStatusBadgeClass(app.Status)">@app.Status</span>
          </td>
          <td class="text-end pe-3">
            @if (app.Status == LeaveStatus.Pending)
            {
              <button class="btn btn-sm btn-outline-danger" @onclick="() => OnCancel.InvokeAsync(app)">Cancel</button>
            }
          </td>
        </tr>
      }
    </tbody>
  </table>
</div>

@code {
  [Parameter] public List<UnifiedRequestDto> Applications { get; set; } = new();
  [Parameter] public EventCallback<UnifiedRequestDto> OnCancel { get; set; }
  private async Task HandleCancel(UnifiedRequestDto app)
  {
    await OnCancel.InvokeAsync(app);
  }
  private string GetStatusBadgeClass(LeaveStatus status) => status switch
  {
    LeaveStatus.Pending => "bg-warning text-dark",
    LeaveStatus.Approved => "bg-success",
    LeaveStatus.Rejected => "bg-danger",
    LeaveStatus.Cancelled => "bg-secondary-subtle  border-secondary-subtle",
    _ => "bg-secondary"
  };
}