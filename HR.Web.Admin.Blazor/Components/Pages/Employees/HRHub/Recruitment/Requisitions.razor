@page "/recruitment/requisitions"
@using HR.Services.DTO.Recruitment
@using HR.Core.Enums
@using HR.Services.Interfaces
@inject IRequisitionService RequisitionService
@inject NavigationManager Nav
@rendermode InteractiveServer
@inject IJSRuntime JS
<div class="d-flex justify-content-between align-items-center mb-4">
  <h3 class="mb-0">Job Requisitions</h3>

  <button class="btn btn-primary shadow-sm px-4"
          @onclick="GoToCreateRequisition">
    + Create Requisition
  </button>

</div>

<!-- ================= DASHBOARD METRICS ================= -->
<div class="row mb-4">
  <div class="col-md-3">
    <div class="card shadow-sm p-3 text-center">
      <h6>Draft</h6>
      <h4 class="text-secondary">@DraftCount</h4>
    </div>
  </div>
  <div class="col-md-3">
    <div class="card shadow-sm p-3 text-center">
      <h6>Pending</h6>
      <h4 class="text-warning">@PendingCount</h4>
    </div>
  </div>
  <div class="col-md-3">
    <div class="card shadow-sm p-3 text-center">
      <h6>Approved</h6>
      <h4 class="text-success">@ApprovedCount</h4>
    </div>
  </div>
  <div class="col-md-3">
    <div class="card shadow-sm p-3 text-center">
      <h6>Rejected</h6>
      <h4 class="text-danger">@RejectedCount</h4>
    </div>
  </div>
</div>

<!-- ================= FILTERS ================= -->
<div class="card shadow-sm p-3 mb-3">
  <div class="row">
    <div class="col-md-4">
      <input class="form-control"
             placeholder="Search job title or requisition #"
             @bind="SearchTerm"
             @bind:event="oninput" />
    </div>
    <div class="col-md-3">
      <select class="form-select" @bind="SelectedStatus">
        <option value="">All Status</option>
        @foreach (var status in Enum.GetValues<RequisitionStatus>())
        {
          <option value="@status">@status</option>
        }
      </select>
    </div>
  </div>
</div>

<!-- ================= TABLE ================= -->
@if (IsLoading)
{
  <div class="text-center p-5">
    <div class="spinner-border text-primary"></div>
  </div>
}
else if (!FilteredRequisitions.Any())
{
  <div class="alert alert-info">No requisitions found.</div>
}
else
{
  <table class="table table-hover shadow-sm">
    <thead class="table-light">
      <tr>
        <th>#</th>
        <th>Job</th>
        <th>Department</th>
        <th>Status</th>
        <th>Approval</th>
        <th>Created</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      @foreach (var req in PaginatedRequisitions)
      {
        <tr>
          <td>@req.RequisitionNumber</td>
          <td>@req.JobTitle</td>
          <td>@req.DepartmentName</td>

          <td>
            <span class="badge @GetStatusBadge(req.Status)">
              @req.Status
            </span>
          </td>

          <td>
            @if (req.Status == RequisitionStatus.PendingApproval)
            {
              <span class="text-warning">
                Level @GetCurrentPendingLevel(req)
              </span>
            }
            else if (req.Status == RequisitionStatus.Approved)
            {
              <span class="text-success">Completed</span>
            }
            else
            {
              <span>-</span>
            }
          </td>

          <td>@req.CreatedAt.ToString("MMM dd, yyyy")</td>
          <td>
            <button class="btn btn-sm btn-outline-info me-2"
                    @onclick="() => ViewDetails(req.Id)">
              View
            </button>

            <button class="btn btn-sm btn-outline-secondary"
                    @onclick="() => ToggleTimeline(req.Id)">
              Timeline
            </button>

            <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => OpenDeleteModal(req.Id, req.RequisitionNumber)">
              <i class="bi bi-trash"></i> Delete
            </button>
          </td>

        </tr>

        @if (ExpandedRowId == req.Id)
        {
          <tr class="bg-light">
            <td colspan="7">
              <div class="p-3">
                @foreach (var approval in req.Approvals.OrderBy(a => a.ApprovalLevel))
                {
                  <div class="border-start border-3 ps-3 mb-3 border-primary">
                    <strong>Level @approval.ApprovalLevel</strong>
                    <div>Status: <span class="badge bg-info">@approval.Status</span></div>
                    @if (!string.IsNullOrEmpty(approval.ActionByName))
                    {
                      <div class="small">By: @approval.ActionByName</div>
                    }
                    <div class="small text-muted">
                      @(approval.ActionDate?.ToString("g") ?? "Awaiting action")
                    </div>
                  </div>
                }
              </div>
            </td>
          </tr>
        }
      }
    </tbody>
  </table>

  <!-- ================= PAGINATION ================= -->
  <div class="d-flex justify-content-between align-items-center mt-3">
    <div>
      Page @CurrentPage of @TotalPages
    </div>
    <div>
      <button class="btn btn-sm btn-outline-secondary me-2"
              disabled="@(CurrentPage == 1)"
              @onclick="PreviousPage">
        Previous
      </button>

      <button class="btn btn-sm btn-outline-secondary"
              disabled="@(CurrentPage == TotalPages)"
              @onclick="NextPage">
        Next
      </button>
    </div>
  </div>
}
@if (ShowDeleteModal)
{
  <div class="modal fade show d-block" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content border-danger shadow">
        <div class="modal-header bg-danger text-white">
          <h5 class="modal-title">Confirm Delete</h5>
          <button class="btn-close btn-close-white" @onclick="CloseDeleteModal"></button>
        </div>
        <div class="modal-body text-center p-4">
          <i class="bi bi-exclamation-triangle text-danger" style="font-size: 3rem;"></i>
          <p class="mt-3">Are you sure you want to delete requisition <strong>@SelectedRequisitionNumber</strong>?</p>
          <p class="text-muted small">This action is permanent and cannot be undone.</p>
        </div>
        <div class="modal-footer">
          <button class="btn btn-secondary" @onclick="CloseDeleteModal">Cancel</button>
          <button class="btn btn-danger" @onclick="ConfirmDelete">Confirm Delete</button>
        </div>
      </div>
    </div>
  </div>
  <div class="modal-backdrop fade show"></div>
}

@if (ShowSuccessAlert)
{
  <div class="position-fixed top-0 end-0 p-3" style="z-index: 9999">
    <div class="alert alert-success alert-dismissible fade show shadow-lg" role="alert">
      <strong>Success!</strong> Requisition deleted successfully.
      <button type="button" class="btn-close" @onclick="() => ShowSuccessAlert = false"></button>
    </div>
  </div>
}
@code {
  private bool ShowDeleteModal = false;
  private bool ShowSuccessAlert = false;
  private Guid RequisitionIdToDelete;
  private string SelectedRequisitionNumber = "";
  private List<RequisitionViewDto> requisitions = new();
  private bool IsLoading = true;

  // Filters
  private string? SearchTerm;
  private RequisitionStatus? SelectedStatus;

  // Pagination
  private int CurrentPage = 1;
  private int PageSize = 5;

  // Timeline
  private Guid? ExpandedRowId;

  protected override async Task OnParametersSetAsync()
  {
    await LoadRequisitions();
  }

  private async Task LoadRequisitions()
  {
    IsLoading = true;
    requisitions = await RequisitionService.GetAllAsync();
    IsLoading = false;
  }

  // ================= FILTER =================

  private IEnumerable<RequisitionViewDto> FilteredRequisitions =>
      requisitions.Where(r =>
          (string.IsNullOrWhiteSpace(SearchTerm) ||
           r.JobTitle.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase) ||
           r.RequisitionNumber.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase))
          &&
          (!SelectedStatus.HasValue || r.Status == SelectedStatus.Value)

      ).OrderByDescending(r => r.CreatedAt);

  // ================= PAGINATION =================

  private int TotalPages =>
      (int)Math.Ceiling(FilteredRequisitions.Count() / (double)PageSize);

  private IEnumerable<RequisitionViewDto> PaginatedRequisitions =>
      FilteredRequisitions
          .Skip((CurrentPage - 1) * PageSize)
          .Take(PageSize);

  private void NextPage()
  {
    if (CurrentPage < TotalPages)
      CurrentPage++;
  }

  private void PreviousPage()
  {
    if (CurrentPage > 1)
      CurrentPage--;
  }

  // ================= METRICS =================

  private int DraftCount => requisitions.Count(r => r.Status == RequisitionStatus.Draft);
  private int PendingCount => requisitions.Count(r => r.Status == RequisitionStatus.PendingApproval);
  private int ApprovedCount => requisitions.Count(r => r.Status == RequisitionStatus.Approved);
  private int RejectedCount => requisitions.Count(r => r.Status == RequisitionStatus.Rejected);

  // ================= APPROVAL =================

  private int GetCurrentPendingLevel(RequisitionViewDto req)
  {
    var pending = req.Approvals
        .FirstOrDefault(a => a.Status.Equals("Pending", StringComparison.OrdinalIgnoreCase));

    return pending?.ApprovalLevel ?? 0;
  }

  private void ToggleTimeline(Guid id)
  {
    ExpandedRowId = ExpandedRowId == id ? null : id;
  }

  private string GetStatusBadge(RequisitionStatus status) => status switch
  {
    RequisitionStatus.Draft => "bg-secondary",
    RequisitionStatus.PendingApproval => "bg-warning text-dark",
    RequisitionStatus.Approved => "bg-success",
    RequisitionStatus.Rejected => "bg-danger",
    _ => "bg-secondary"
  };
  private void GoToCreateRequisition()
  {
    Nav.NavigateTo("/recruitment/create");
  }
  private void ViewDetails(Guid id)
  {
    Nav.NavigateTo($"/recruitment/details/{id}");
  }

  private async Task ConfirmDelete()
  {
    // 1. CALL THE SERVICE FIRST
    var success = await RequisitionService.DeleteAsync(RequisitionIdToDelete);

    if (success)
    {
      // 2. IMMEDIATELY KILL THE MODAL AND SHOW ALERT
      ShowDeleteModal = false;
      ShowSuccessAlert = true;

      // 3. FORCE BROWSER TO RENDER THE ABOVE CHANGES NOW
      StateHasChanged();

      // 4. GIVE THE UI A MILLISECOND TO BREATHE (This removes the lag)
      await Task.Yield();

      // 5. NOW REFRESH THE DATA IN THE BACKGROUND
      await LoadRequisitions();
      StateHasChanged();

      // 6. WAIT 3 SECS THEN HIDE ALERT
      await Task.Delay(3000);
      ShowSuccessAlert = false;
      StateHasChanged();
    }
  }
  private void OpenDeleteModal(Guid id, string reqNumber)
  {
    RequisitionIdToDelete = id;
    SelectedRequisitionNumber = reqNumber;
    ShowDeleteModal = true;
  }

  // 2. Close the Card
  private void CloseDeleteModal()
  {
    ShowDeleteModal = false;
    RequisitionIdToDelete = Guid.Empty;
  }
}
