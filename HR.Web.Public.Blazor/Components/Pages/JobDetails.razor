@page "/job/{Id:guid}"
@using HR.Services.DTO.Recruitment
@using HR.Services.Interfaces
@inject IRequisitionService RequisitionService
@inject NavigationManager Nav
@rendermode InteractiveServer

<div class="container mt-5 mb-5">
  @if (job == null)
  {
    <div class="text-center p-5">
      <div class="spinner-border text-navy" role="status"></div>
      <p class="mt-2 text-muted">Loading job details...</p>
    </div>
  }
  else
  {
    <div class="row justify-content-center">
      <div class="col-lg-10">
        <button class="btn btn-link text-decoration-none mb-4 p-0 text-navy" @onclick='() => Nav.NavigateTo("/")'>
          <i class="bi bi-arrow-left"></i> Back to All Openings
        </button>

        <div id="job-details" class="card shadow-sm border-0 overflow-hidden">
          @* THE NAVY HEADER *@
          <div class="card-header p-4 p-md-5 border-0 text-white" style="background-color: #222240;">
            <div class="row align-items-center">
              <div class="col-md-8">
                <span class="badge bg-light text-dark mb-3 px-3 py-2">@job.ContractType</span>
                <h1 class="display-5 fw-bold mb-0">@job.Title</h1>
                <div class="d-flex flex-wrap gap-3 mt-3 opacity-75">
                  <span><i class="bi bi-geo-alt-fill me-1"></i>@job.Location</span>
                  <span><i class="bi bi-calendar-check me-1"></i>Published @job.PublishedAt.ToString("MMM dd, yyyy")</span>
                </div>
              </div>
            </div>
          </div>

          <div class="card-body p-4 p-md-5">
            <div class="row">
              <div class="col-md-8">
                <h4 class="fw-bold mb-4" style="color: #222240;">Job Description</h4>
                <div class="job-body text-secondary">
                  @((MarkupString)job.Description)
                </div>
              </div>

              <div class="col-md-4">
                <div class="bg-light rounded p-4 sticky-top shadow-sm" style="top: 2rem; border-top: 4px solid #222240;">
                  <h5 class="fw-bold mb-3" style="color: #222240;">Interested?</h5>
                  <p class="small text-muted mb-4">
                    Join our team and help us build the future of HR technology.
                  </p>
                  <button class="btn btn-navy btn-lg w-100 shadow-sm fw-bold" @onclick="GoToApply">
                    Apply for this Position
                  </button>
                  <div class="mt-3 text-center">
                    <small class="text-muted"><i class="bi bi-clock me-1"></i>Takes less than 5 minutes</small>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  }
</div>

<style>
  .job-header {
    background: linear-gradient(135deg, #222240, #2e2e50);
  }

  .apply-box {
    background: #f8f9fa;
    border-top: 4px solid #222240;
    position: sticky;
    top: 2rem;
  }

  .job-body {
    line-height: 1.8;
    font-size: 1.05rem;
    color: #444;
  }

    .job-body ul,
    .job-body ol {
      padding-left: 1.8rem !important;
      margin-bottom: 1.2rem;
    }

    .job-body li {
      margin-bottom: 0.5rem;
    }

  .text-navy {
    color: #222240 !important;
  }

  .btn-navy {
    background-color: #222240;
    color: white;
    border: none;
    transition: all 0.25s ease;
  }

    .btn-navy:hover {
      background-color: #1a1a33;
      transform: translateY(-2px);
      box-shadow: 0 4px 12px rgba(34, 34, 64, 0.25);
    }
</style>

@code {
  [Parameter] public Guid Id { get; set; }
  private PublicJobDto? job;
  private bool _shouldScroll = false;

  protected override async Task OnInitializedAsync()
  {
    job = await RequisitionService.GetPublicJobByIdAsync(Id);
    _shouldScroll = true;


    if (job != null && string.IsNullOrWhiteSpace(job.Description))
    {
      Console.WriteLine("DEBUG: Job Description is empty in the database!");
    }
  }

  protected override Task OnAfterRenderAsync(bool firstRender)
  {
    if (_shouldScroll)
    {
      _shouldScroll = false;
      Nav.NavigateTo($"/job/{Id}#job-details", forceLoad: false);
    }
    return Task.CompletedTask;
  }

  private void GoToApply()
  {
    Nav.NavigateTo($"/job/apply/{Id}");
  }
}