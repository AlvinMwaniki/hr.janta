@page "/employees/create_users"
@using HR.Services.DTO
@using HR.Services.Constants
@using HR.Services.Interfaces
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Authorization
@rendermode InteractiveServer


@attribute [Authorize(Roles = AppRoles.Admin)]

@inject IUserAccountService AccountService
@inject NavigationManager Navigation

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="m-0"><i class="fas fa-user-plus me-2"></i> Create New User Account</h3>
    <button @onclick:stopPropagation @onclick="NavigateToManagement" class="btn btn-outline-secondary">
        <i class="fas fa-arrow-left me-2"></i> Back to Management
    </button>
</div>

<div class="row justify-content-center">
  <div class="col-lg-6">
    <div class="card shadow p-4">
      <EditForm Model="Model" OnValidSubmit="HandleSubmit">
        <DataAnnotationsValidator />
                
                <div class="mb-3">
                    <label for="username" class="form-label">Username</label>
                    <InputText id="username" class="form-control" @bind-Value="Model.Username" />
                    <ValidationMessage For="() => Model.Username" class="text-danger" />
                </div>
                
                <div class="mb-3">
                    <label for="email" class="form-label">Email</label>
                    <InputText id="email" class="form-control" @bind-Value="Model.Email" />
                    <ValidationMessage For="() => Model.Email" class="text-danger" />
                </div>

                <div class="mb-3">
                    <label for="password" class="form-label">Password</label>
                    <InputText id="password" type="password" class="form-control" @bind-Value="Model.Password" />
                    <ValidationMessage For="() => Model.Password" class="text-danger" />
                </div>

                <div class="mb-4">
                    <label for="role" class="form-label">Primary Role</label>
                    <InputSelect id="role" class="form-select" @bind-Value="Model.RoleName">
                        <option value="@AppRoles.Employee">Employee</option>
                        <option value="@AppRoles.Admin">Admin</option>
                    </InputSelect>
                    <ValidationMessage For="() => Model.RoleName" class="text-danger" />
                </div>
                
                @if (!string.IsNullOrEmpty(ErrorMessage))
                {
                    <div class="alert alert-danger">@ErrorMessage</div>
                }

                <div class="d-grid">
                    <button type="submit" class="btn btn-success btn-lg" disabled="@IsBusy">
                        @if (IsBusy)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            <span>Creating...</span>
                        }
                        else
                        {
                            <i class="fas fa-check me-2"></i> <span>Create Account; </span>
                        }
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
</div>

@code {
    private UserCreationDto Model { get; set; } = new();

    private string? ErrorMessage;
    private bool IsBusy = false;
    private void NavigateToManagement()
    {
        Navigation.NavigateTo("/employees/Manage_users");
    }

    private async Task HandleSubmit()
    {
        IsBusy = true;
        ErrorMessage = null;
        try
        {
            await AccountService.CreateUserAsync(Model);
            
            // Redirect back to the management page on success
            Navigation.NavigateTo("/employees/Manage_users");
        }
        catch (InvalidOperationException ex)
        {
            ErrorMessage = ex.Message;
        }
        catch (Exception)
        {
            ErrorMessage = "An unexpected error occurred while creating the user.";
        }
        finally
        {
            IsBusy = false;
        }
    }
}