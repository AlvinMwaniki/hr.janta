@page "/salarymanagement"
@rendermode InteractiveServer
@inject IJSRuntime JS

<PageTitle>Salary Management</PageTitle>

<style>
  @@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;600&display=swap');

  .sm-wrap {
    font-family: 'Plus Jakarta Sans',sans-serif;
    background: #f0f4ff;
    min-height: 100vh;
    padding: 2rem;
  }

  .sm-hdr {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.75rem;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .sm-ttl {
    font-size: 1.6rem;
    font-weight: 800;
    color: #0f1c3f;
    letter-spacing: -0.03em;
  }

  .sm-sub {
    font-size: 0.8rem;
    color: #64748b;
    margin-top: 3px;
  }

  .kpi-row {
    display: grid;
    grid-template-columns: repeat(4,1fr);
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .kpi {
    background: white;
    border-radius: 14px;
    padding: 1.2rem 1.4rem;
    border: 1px solid #e2e8f0;
    position: relative;
    overflow: hidden;
  }

    .kpi::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      height: 4px;
      border-radius: 0 0 4px 4px;
    }

  .kb::after {
    background: #1a56db;
  }

  .kg::after {
    background: #0e9f6e;
  }

  .kr::after {
    background: #e02424;
  }

  .ka::after {
    background: #d97706;
  }

  .kl {
    font-size: 0.66rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #94a3b8;
  }

  .kv {
    font-size: 1.7rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    margin: 0.25rem 0 0.1rem;
    line-height: 1;
  }

  .kb .kv {
    color: #1a56db;
  }

  .kg .kv {
    color: #0e9f6e;
  }

  .kr .kv {
    color: #e02424;
  }

  .ka .kv {
    color: #d97706;
  }

  .ks {
    font-size: 0.72rem;
    color: #94a3b8;
  }

  .card {
    background: white;
    border-radius: 16px;
    border: 1px solid #e2e8f0;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(0,0,0,.04);
  }

  .ch {
    padding: 1rem 1.5rem;
    border-bottom: 1px solid #f1f5f9;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: .5rem;
  }

  .ct {
    font-weight: 700;
    font-size: .92rem;
    color: #0f1c3f;
  }

  table {
    width: 100%;
    border-collapse: collapse;
  }

  thead th {
    padding: .65rem 1.1rem;
    font-size: .66rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .07em;
    color: #94a3b8;
    background: #f8fafc;
    border-bottom: 1px solid #e2e8f0;
    text-align: left;
    white-space: nowrap;
  }

  tbody tr {
    border-bottom: 1px solid #f1f5f9;
    transition: background .15s;
    cursor: pointer;
  }

    tbody tr:hover {
      background: #f0f5ff;
    }

  td {
    padding: .82rem 1.1rem;
    font-size: .875rem;
    vertical-align: middle;
  }

  .av {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: .72rem;
    flex-shrink: 0;
  }

  .er {
    display: flex;
    align-items: center;
    gap: .6rem;
  }

  .en {
    font-weight: 600;
    font-size: .875rem;
    color: #1e293b;
  }

  .ec {
    font-size: .7rem;
    color: #94a3b8;
  }

  .mono {
    font-family: 'JetBrains Mono',monospace;
    font-size: .81rem;
  }

  .bdg {
    display: inline-flex;
    align-items: center;
    padding: 3px 9px;
    border-radius: 99px;
    font-size: .68rem;
    font-weight: 700;
  }

  .bg {
    background: #e3faf3;
    color: #0e9f6e;
  }

  .bb {
    background: #e8effe;
    color: #1a56db;
  }

  .ba {
    background: #fef3c7;
    color: #d97706;
  }

  .btn {
    padding: .42rem .95rem;
    border-radius: 8px;
    font-family: 'Plus Jakarta Sans',sans-serif;
    font-size: .81rem;
    font-weight: 600;
    border: none;
    cursor: pointer;
    transition: all .2s;
    display: inline-flex;
    align-items: center;
    gap: .4rem;
  }

  .btn-dk {
    background: #0f1c3f;
    color: white;
  }

    .btn-dk:hover {
      background: #1a2d5a;
    }

  .btn-gh {
    background: transparent;
    color: #64748b;
    border: 1px solid #e2e8f0;
  }

    .btn-gh:hover {
      border-color: #0f1c3f;
      color: #0f1c3f;
    }

  .btn-sm {
    padding: .28rem .7rem;
    font-size: .73rem;
  }

  .srch {
    display: flex;
    align-items: center;
    gap: .5rem;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: .38rem .85rem;
  }

    .srch input {
      border: none;
      background: transparent;
      font-family: 'Plus Jakarta Sans',sans-serif;
      font-size: .84rem;
      width: 190px;
      outline: none;
      color: #1e293b;
    }

  .sel {
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: .38rem .7rem;
    font-family: 'Plus Jakarta Sans',sans-serif;
    font-size: .81rem;
    color: #1e293b;
    background: white;
    outline: none;
  }

  .modal-bg {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,.5);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 9999;
  }

  .modal-bx {
    background: white;
    border-radius: 16px;
    width: 450px;
    max-width: 96vw;
    overflow: hidden;
    box-shadow: 0 20px 60px rgba(0,0,0,.2);
  }

  .mhd {
    background: #0f1c3f;
    color: white;
    padding: 1.2rem 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .mbody {
    padding: 1.5rem;
  }

  .pr {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: .42rem 0;
    border-bottom: 1px dashed #f1f5f9;
    font-size: .83rem;
  }

    .pr:last-child {
      border: none;
    }

  .pl {
    color: #64748b;
  }

  .pv {
    font-family: 'JetBrains Mono',monospace;
    font-weight: 600;
  }

  .netbox {
    background: #0f1c3f;
    color: white;
    border-radius: 10px;
    padding: .95rem 1.2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 1rem;
  }
</style>

<div class="sm-wrap">
  <div class="sm-hdr">
    <div>
      <div class="sm-ttl"><i class="fas fa-money-bill-wave me-2" style="color:#1a56db"></i>Salary Management</div>
      <div class="sm-sub">@DateTime.Now.ToString("MMMM yyyy") · @Filtered.Count employees</div>
    </div>
    <div style="display:flex;gap:.6rem;flex-wrap:wrap">
      <div class="srch">
        <i class="fas fa-search" style="color:#94a3b8;font-size:.77rem"></i>
        <input placeholder="Search employee..." @bind="search" @bind:event="oninput" />
      </div>
      <select class="sel" @bind="deptFilter">
        <option value="">All Departments</option>
        @foreach (var d in Emps.Select(e => e.Dept).Distinct().OrderBy(x => x))
        {
          <option value="@d">@d</option>
        }
      </select>
      <button class="btn btn-gh btn-sm" @onclick='async () => await JS.InvokeVoidAsync("window.print")'><i class="fas fa-print"></i> Print</button>
    </div>
  </div>

  <div class="kpi-row">
    <div class="kpi kb"><div class="kl">Total Gross</div><div class="kv">@((Emps.Sum(e => e.Salary) / 1000m).ToString("N0"))K</div><div class="ks">KES · per month</div></div>
    <div class="kpi kg"><div class="kl">Total Net Pay</div><div class="kv">@((Emps.Sum(e => Pay(e.Salary).Net) / 1000m).ToString("N0"))K</div><div class="ks">After all deductions</div></div>
    <div class="kpi kr"><div class="kl">Total Deductions</div><div class="kv">@((Emps.Sum(e => Pay(e.Salary).TotalDed) / 1000m).ToString("N0"))K</div><div class="ks">PAYE + NHIF + NSSF + Housing</div></div>
    <div class="kpi ka"><div class="kl">Avg. Salary</div><div class="kv">@((Emps.Average(e => e.Salary) / 1000m).ToString("N0"))K</div><div class="ks">KES per employee</div></div>
  </div>

  <div class="card">
    <div class="ch">
      <div class="ct"><i class="fas fa-list me-2" style="color:#1a56db"></i>Employee Salary Register</div>
      <button class="btn btn-dk btn-sm"><i class="fas fa-download"></i> Export Excel</button>
    </div>
    <div style="overflow-x:auto">
      <table>
        <thead><tr><th>#</th><th>Employee</th><th>Job Title</th><th>Dept</th><th>Type</th><th>Basic Salary</th><th>PAYE</th><th>NHIF</th><th>NSSF</th><th>Housing</th><th>Net Pay</th><th></th></tr></thead>
        <tbody>
          @{
            int n = 1;
          }
          @foreach (var e in Filtered)
          {
            var c = Pay(e.Salary);
            <tr @onclick="() => sel = e">
              <td style="color:#94a3b8;font-size:.75rem">@(n++)</td>
              <td><div class="er"><div class="av" style="background:@e.Bg;color:@e.Col">@e.Init</div><div><div class="en">@e.Name</div><div class="ec">@e.Code</div></div></div></td>
              <td style="color:#475569;font-size:.82rem;max-width:130px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">@e.Title</td>
              <td style="color:#64748b;font-size:.82rem">@e.Dept</td>
              <td><span class="bdg @e.CBdg">@e.CLabel</span></td>
              <td class="mono" style="font-weight:600">@e.Salary.ToString("N0")</td>
              <td class="mono" style="color:#e02424">@c.PAYE.ToString("N0")</td>
              <td class="mono" style="color:#e02424">@c.NHIF.ToString("N0")</td>
              <td class="mono" style="color:#e02424">@c.NSSF.ToString("N0")</td>
              <td class="mono" style="color:#e02424">@c.Housing.ToString("N0")</td>
              <td class="mono" style="color:#0e9f6e;font-weight:700">@c.Net.ToString("N0")</td>
              <td><button class="btn btn-gh btn-sm" @onclick:stopPropagation @onclick="() => sel = e"><i class="fas fa-eye"></i></button></td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  </div>
</div>

@if (sel != null)
{
  var c = Pay(sel.Salary);
  <div class="modal-bg" @onclick="() => sel = null">
    <div class="modal-bx" @onclick:stopPropagation>
      <div class="mhd">
        <div><div style="font-weight:700;font-size:1rem">@sel.Name</div><div style="font-size:.74rem;color:#94a3b8">@sel.Title · @sel.Dept</div></div>
        <button @onclick="() => sel = null" style="background:none;border:none;color:white;cursor:pointer;font-size:1rem">✕</button>
      </div>
      <div class="mbody">
        <div class="pr"><span class="pl">Employee Code</span><span class="pv">@sel.Code</span></div>
        <div class="pr"><span class="pl">Contract</span><span class="bdg @sel.CBdg">@sel.CLabel</span></div>
        <div class="pr" style="margin-top:.4rem"><span class="pl">Basic Salary</span><span class="pv" style="color:#0e9f6e">KES @sel.Salary.ToString("N2")</span></div>
        <div style="margin:.7rem 0 .35rem;font-size:.65rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:#94a3b8">Deductions</div>
        <div class="pr"><span class="pl">PAYE (Income Tax)</span><span class="pv" style="color:#e02424">- KES @c.PAYE.ToString("N2")</span></div>
        <div class="pr"><span class="pl">NHIF</span><span class="pv" style="color:#e02424">- KES @c.NHIF.ToString("N2")</span></div>
        <div class="pr"><span class="pl">NSSF (6%)</span><span class="pv" style="color:#e02424">- KES @c.NSSF.ToString("N2")</span></div>
        <div class="pr"><span class="pl">Housing Levy (1.5%)</span><span class="pv" style="color:#e02424">- KES @c.Housing.ToString("N2")</span></div>
        <div class="netbox"><span style="color:#94a3b8;font-size:.8rem">NET PAY</span><span style="font-family:'JetBrains Mono',monospace;font-weight:700;color:#34d399;font-size:1.2rem">KES @c.Net.ToString("N2")</span></div>
        <div style="display:flex;gap:.5rem;margin-top:1rem">
          <button class="btn btn-gh btn-sm" style="flex:1" @onclick="() => sel = null">Close</button>
          <a class="btn btn-dk btn-sm" style="flex:1;justify-content:center;text-decoration:none" href="/payslips/my"><i class="fas fa-file-invoice-dollar"></i> Payslip</a>
        </div>
      </div>
    </div>
  </div>
}

@code {
  string search = "", deptFilter = "";
  EmpR? sel;
  record PayR(decimal PAYE, decimal NHIF, decimal NSSF, decimal Housing, decimal TotalDed, decimal Net);
  record EmpR(string Code, string Name, string Title, string Dept, decimal Salary, int Contract, string Init, string Bg, string Col, string CBdg, string CLabel);

  PayR Pay(decimal g)
  {
    var nssf = Math.Round(g * .06m, 2); var h = Math.Round(g * .015m, 2);
    decimal nhif = g switch { <= 5999 => 150, <= 7999 => 300, <= 11999 => 400, <= 14999 => 500, <= 19999 => 600, <= 24999 => 750, <= 29999 => 850, <= 34999 => 900, <= 39999 => 950, <= 44999 => 1000, <= 49999 => 1100, <= 59999 => 1200, <= 69999 => 1300, <= 79999 => 1400, <= 89999 => 1500, <= 99999 => 1600, _ => 1700 };
    var tax = g - nssf; decimal paye = tax switch { <= 24000 => tax * .10m, <= 32333 => 2400 + (tax - 24000) * .25m, <= 500000 => 4483.25m + (tax - 32333) * .30m, <= 800000 => 144433.25m + (tax - 500000) * .325m, _ => 241933.25m + (tax - 800000) * .35m };
    paye = Math.Max(0, Math.Round(paye - 2400, 2)); var tot = paye + nhif + nssf + h; return new PayR(paye, nhif, nssf, h, tot, g - tot);
  }
  string[] bgs = { "#dbeafe", "#dcfce7", "#fef3c7", "#fce7f3", "#ede9fe", "#ffedd5", "#f0fdf4", "#e0f2fe" };
  string[] cols = { "#1d4ed8", "#15803d", "#b45309", "#be185d", "#7c3aed", "#c2410c", "#166534", "#0369a1" };
  EmpR Mk(string code, string fn, string ln, string title, string dept, decimal sal, int ct)
  {
    var nm = $"{fn} {ln}"; var init = $"{fn[0]}{ln[0]}".ToUpper(); var i = Math.Abs(nm.GetHashCode()) % bgs.Length;
    return new EmpR(code, nm, title, dept, sal, ct, init, bgs[i], cols[i], ct == 1 ? "bg" : ct == 2 ? "bb" : "ba", ct == 1 ? "Permanent" : ct == 2 ? "Contract" : "Intern");
  }
  List<EmpR> Emps => new(){
        Mk("29122025","Jackason","Munene","Kulima","Operations",65000,1),
        Mk("0000002","Jared","Okumu","HR Officer","HR",72000,1),
        Mk("0000001","Alvin","Mwaniki","Sales Executive","Sales",68000,2),
        Mk("0000001","Ann","Wangui","Operations Head","Operations",145000,1),
        Mk("22022026","Alvin","Kiarie","Full Stack Developer","ICT",110000,1),
        Mk("5558745223","Martin","Kukushi","Fundi Mwitu","Operations",45000,2),
        Mk("050320260107","Mwende","Muthee","Software Developer","ICT",200000,1),
        Mk("000000003","Jame","Shikuku","Software Developer","ICT",95000,1),
        Mk("08022026","Kenneth","Oluthe","Sales Executive","Sales",78000,2),
        Mk("20251219","Angela","Atieno","Supply Chain Officer","Supply Chain",82000,1),
        Mk("22022026","John","Munene","Procurement Officer","Procurement",88000,1),
        Mk("000000004","Jeff","Ntongai","HR Manager","HR",92000,1),
        Mk("20251230","Yobra","Mnoma","Supply Chain Officer","Supply Chain",75000,1),
        Mk("90OIUUU","Rogers","Kamori","IT Support","ICT",68000,1),
        Mk("202002221824","Don","Muthee","Marketing Head","Marketing",125000,1),
        Mk("05032026","Rose","Gichuru","Full Stack Developer","ICT",110000,1),
        Mk("000000003","Richard","Magoma","ERT Officer","Operations",55000,1),
        Mk("20251219","Valentine","Wahito","Supply Chain Officer","Supply Chain",80000,1),
        Mk("123456","Arsenal","Otieno","Operations Head","Operations",138000,1),
        Mk("07022026","Megan","Wanjiku","Customer Care","Customer Service",62000,2),
        Mk("21012026","Rose","Gichuru","Supply Chain","Supply Chain",76000,1),
        Mk("000000003","Ince","Njenga","ERT Officer","Operations",55000,1),
        Mk("000000003","Jackline","Obure","Operations Head","Operations",132000,1),
        Mk("20260222","Alvin","Mwaniki","Full Stack Developer","ICT",115000,1),
        Mk("20251219","Rose","Gichuru2","Supply Chain Officer","Supply Chain",78000,1),
    };
  List<EmpR> Filtered => Emps.Where(e => (string.IsNullOrEmpty(search) || e.Name.Contains(search, StringComparison.OrdinalIgnoreCase) || e.Title.Contains(search, StringComparison.OrdinalIgnoreCase)) && (string.IsNullOrEmpty(deptFilter) || e.Dept == deptFilter)).ToList();
}
