@using HR.Core.Enums
@using HR.Services.DTO
@inject NavigationManager Nav


<div class="card shadow-sm border-0">
  <div class="card-header  py-3">
    <h5 class="mb-0 prox-header-text"><i class="fas fa-clipboard-check me-2 text-primary"></i> Pending Staff Approvals</h5>
  </div>
  <div class="table-responsive">
    <table class="table align-middle mb-0">
      <thead class="bg-light text-secondary small text-uppercase">
        <tr>
          <th class="ps-3">Employee & Type</th>
          <th>Request Detail</th>
          <th class="text-center">Date</th>
          <th class="text-end pe-3">Actions</th>
        </tr>
      </thead>
      <tbody>
        @foreach (var app in Applications)
        {
          <tr>
            <td class="ps-3">
              <div class="fw-bold">@app.Description</div>
              @if (app.RequestType == "Leave")
              {
                <span class="badge rounded-pill bg-primary-subtle text-primary border border-primary-subtle px-2">
                  <i class="fas fa-calendar-alt me-1"></i> Leave
                </span>
              }
              else
              {
                <span class="badge rounded-pill bg-success-subtle text-success border border-success-subtle px-2">
                  <i class="fas fa-hand-holding-usd me-1"></i> Advance
                </span>
              }
            </td>
            <td><div class="small">@app.Detail</div></td>
            <td class="text-center small text-muted">@app.Date.ToShortDateString()</td>
            <td class="text-end pe-3">
              <button class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-bold"
                      @onclick='() => Nav.NavigateTo($"/admin/leaves?reviewId={app.Id}")'>
                REVIEW <i class="fas fa-external-link-alt ms-1 small"></i>
              </button>
            </td>
          </tr>
        }
      </tbody>
    </table>
  </div>
</div>

@code {
  [Parameter] public List<UnifiedRequestDto> Applications { get; set; } = new();
  [Parameter] public EventCallback<(UnifiedRequestDto Request, LeaveStatus Status)> OnAction { get; set; }
}