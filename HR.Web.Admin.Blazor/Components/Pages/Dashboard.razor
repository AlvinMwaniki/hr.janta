@page "/dashboard"
@using HR.Services
@using HR.Services.DTO
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Authorization
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using HR.Services.Constants
@using HR.Web.Admin.Blazor.Components.Charts
@using HR.Services.Interfaces
@using HR.Web.Admin.Blazor.Infrastructure
@using HR.Web.Admin.Blazor.Components.Widgets
@rendermode InteractiveServer
@attribute [Authorize]
@inject DashboardService DashboardService
@inject HR.Services.Services.ImpersonationService Impersonation
@implements IDisposable
@inject IJSRuntime JS
@inject ILeaveService LeaveService
@inject ILeaveNotificationService NotificationService
@inject IContractService ContractService
@inject NavigationManager Nav
@inject IAppNotificationService AppNotifyService

<h3 class="mb-4">Dashboard</h3>

@if (totals is null)
{
  <p>Loading...</p>
}
else
{
  // ===========ADMIN DASHBOARD VIEW===========
  @if (!ShowEmployeeView){
  <AuthorizeView Policy="@AppPermissions.ViewAdminDashboard">
    <Authorized>
  <div class="row g-2">
    <!-- Total Employees Card -->
        <div class="col-md-3">
            <div class="card prox-metric-card">
              <div class="card-body">
                <div class="prox-metric-title">Total Employees</div>
                <div class="prox-metric-value">@totals.Employees</div>
              </div>
