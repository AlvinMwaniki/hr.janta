@using MudBlazor
@using HR.Core.DTOs.Reports
@using HR.Core.Enums
@using System.Linq

@((MarkupString)@"
<style>

    .report-wrapper { background: #f1f5f9; padding: 40px 0; min-height: 100vh; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
.paper-sheet {
        background: white; 
        width: 210mm; 
        min-height: 297mm; 
        height: auto; /* Let it grow based on content */
        margin: 0 auto; 
        padding: 20mm;
        box-sizing: border-box;
        page-break-after: always; /* Each paper-sheet starts a new PDF page */
    }
.chart-box, .ethnicity-grid > div, .premium-card {
        page-break-inside: avoid !important;
        break-inside: avoid !important;
    }


    /* MODERN STAT CARDS */
    .stat-container { display: flex; gap: 20px; margin-bottom: 35px; }
    .premium-card {
        flex: 1; background: #ffffff; border-radius: 12px; padding: 20px;
        border-bottom: 5px solid #3f51b5; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);
        text-align: center;
         display: flex;
       flex-direction: column;
        justify-content: space-between;
    }
    .card-label { font-size: 0.7rem; font-weight: 700; color: #64748b; text-transform: uppercase; letter-spacing: 1px; }
    .card-value { font-size: 2.4rem; font-weight: 900; color: #1e293b; display: block; margin-top: 5px; }

    .section-header {
        font-weight: 800; color: #1e293b; border-left: 6px solid #3f51b5;
        padding-left: 15px; margin: 25px 0 15px 0; text-transform: uppercase;
        font-size: 1.1rem;
    }

    .chart-box { height: 320px; width: 100%; position: relative; }
    .progress-label { font-size: 0.85rem; font-weight: 600; color: #334155; }
    .progress-val { font-weight: 800; color: #3f51b5; }

    

/* Makes the bars thick and solid */
    .mud-chart-bar {
        stroke-width: 38px !important;
        stroke-linecap: round;
        filter: drop-shadow(3px 5px 4px rgba(0,0,0,0.15)); /* 3D Depth effect */
         transition: all 0.3s ease;
    }

    /* Adds a subtle hover effect for interactivity */
    .mud-chart-bar:hover {
        filter: drop-shadow(3px 5px 8px rgba(0,0,0,0.3));
        cursor: pointer;
    }

    /* Container for a premium feel */
 .chart-box {
        background: #ffffff;
        padding: 40px 25px 25px 25px !important;
        border-radius: 24px !important;
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05);
        border: 1px solid #f1f5f9;
        height: 350px;
    }
     .mud-charts-xaxis {
        transform: translateY(10px);
    }
.mud-charts-xaxis text {
        font-weight: 600;
        fill: #64748b !important;
        font-size: 0.75rem;
.ethnicity-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: 40px;
    row-gap: 15px;
    margin-top: 20px;
}

    /* Force chart backgrounds to show up in PDF */
    * {
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
    }

@media print {
    /* Prevent the browser from creating a new page for 'ghost' margins */
    html, body {
        height: 100%;
        overflow: hidden !important;
        margin: 0 !important;
        padding: 0 !important;
    }

    /* Target the very last sheet and tell it NEVER to break after */
    .paper-sheet:last-child {
        page-break-after: avoid !important;
        break-after: avoid !important;
        margin-bottom: 0 !important;
    }
}
</style>
")

<MudDialog>
<DialogContent>
    <div class="report-wrapper">
        @* PAGE 1: EXECUTIVE SUMMARY & FOOTPRINT *@
        <div class="paper-sheet">
            @* Header Section *@
            <div class="d-flex justify-content-between align-end mb-8" style="border-bottom: 3px solid #1e293b; padding-bottom: 20px;">
                <div>
                    <h1 style="font-size: 2.8rem; font-weight: 900; color: #1e293b; margin:0; letter-spacing: -1px;">VISUAL EXPORT</h1>
                    <p style="color: #3f51b5; font-weight: 700; font-size: 1.1rem; margin:0;">Executive Master Audit • @DateTime.Now.ToString("MMMM yyyy")</p>
                </div>
                <div style="text-align: right; font-size: 0.85rem; color: #64748b; line-height: 1.6;">
                    <strong>REPORT ID:</strong> EXEC-@DateTime.Now.ToString("yyyyMMdd")<br />
                    <strong>CONFIDENTIALITY LEVEL:</strong> HIGH
                </div>
            </div>

            @* TOP CARDS *@
            <div class="stat-container">
                <div class="premium-card">
                    <span class="card-label">Permanent Staff</span>
                    <span class="card-value">@PermanentCount</span>
                </div>
                <div class="premium-card">
                    <span class="card-label">Contract Staff</span>
                    <span class="card-value">@(ContractCount + InternCount)</span>
                </div>
                <div class="premium-card">
                    <span class="card-label">Total Workforce</span>
                    <span class="card-value" style="color: #3f51b5;">@(PermanentCount + ContractCount + InternCount)</span>
                </div>
                <div class="premium-card">
                    <span class="card-label">Yearly Exits</span>
                    <span class="card-value" style="color: #ef4444;">@Stats.YearlyExits</span>
                </div>
            </div>

            <div class="report-content">
                @* --- ROW 1: DEPARTMENTS & GENDER --- *@
                <div class="row mb-8">
                    @* Left: Departments *@
                    <div class="col-6">
                        <h2 class="section-header" style="font-size: 1.1rem; font-weight: 700; border-left: 4px solid #3f51b5; padding-left: 10px; margin-bottom: 15px;">Departmental Footprint</h2>
                        <div class="pa-4">
                            @foreach (var dept in Stats.DeptDistribution.OrderByDescending(x => x.EmployeeCount))
                            {
                                <div class="mb-4">
                                    <div class="d-flex justify-content-between mb-1">
                                        <span style="font-size: 0.85rem; font-weight: 600;">@dept.Name</span>
                                        <span class="text-muted" style="font-size:0.75rem;">@dept.EmployeeCount Staff (@Math.Round(dept.Percentage, 1)%)</span>
                                    </div>
                                    <MudProgressLinear Color="MudBlazor.Color.Primary" Value="@dept.Percentage" Size="MudBlazor.Size.Large" Style="height:20px; border-radius:5px;" />
                                </div>
                            }
                        </div>
                    </div>

                    @* Right: Gender Split *@
                    <div class="col-6">
                        <h2 class="section-header" style="font-size: 1.1rem; font-weight: 700; border-left: 4px solid #3f51b5; padding-left: 0px; margin-bottom: 15px;">Gender Split</h2>
                        <div class="chart-box d-flex justify-content-center align-items-center" style="height: 300px;">
                            <MudChart ChartType="MudBlazor.ChartType.Donut"
                                      InputData="@GenderData"
                                      InputLabels="@GenderLabels"
                                      Width="180px" Height="180px"
                                      LegendPosition="MudBlazor.Position.Bottom" />
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* PAGE 2: COMPOSITION, AGE & TRENDS *@
        <div class="paper-sheet">
            <h2 class="section-header">02. Composition & Operational Trends</h2>
            
            @* --- ROW 2: COMPOSITION & AGE (MOVED TO PAGE 2) --- *@
            <div class="row mb-8">
                @* Left: Composition *@
                <div class="col-6">
                    <h2 class="section-header" style="font-size: 1.1rem; font-weight: 700; border-left: 4px solid #3f51b5; padding-left: 0px; margin-bottom: 15px;">Composition</h2>
                    <div class="chart-box d-flex justify-content-center align-items-center" style="height: 280px;">
                        <MudChart ChartType="MudBlazor.ChartType.Pie"
                                  InputData="@(new double[] { PermanentCount, ContractCount, InternCount })"
                                  InputLabels="@(new string[] { "Permanent", "Contract", "Intern" })"
                                  Width="180px" Height="180px"
                                  LegendPosition="MudBlazor.Position.Bottom" />
                    </div>
                </div>

                @* Right: Age Demographics *@
                <div class="col-6">
                    <h2 class="section-header" style="font-size: 1.1rem; font-weight: 700; border-left: 4px solid #3f51b5; padding-left: 0px; margin-bottom: 15px;">Age Demographics</h2>
                    <div class="chart-box d-flex justify-content-center align-items-center" style="height: 280px;">
                        <MudChart ChartType="MudBlazor.ChartType.Donut"
                                  InputData="@AgeData"
                                  InputLabels="@AgeLabels"
                                  Width="180px" Height="180px"
                                  LegendPosition="MudBlazor.Position.Bottom" />
                    </div>
                </div>
            </div>

            <div class="row mt-8">
                <div class="col-6">
                    <h4 class="text-center fw-bold mb-4" style="color:#1e293b">Leave Requests Trend</h4>
                    <div class="chart-box">
                        <MudChart ChartType="MudBlazor.ChartType.Bar"
                                  ChartSeries="@LeaveSeries"
                                  XAxisLabels="@XAxisLabels"
                                  Width="100%" Height="350px"
                                  ChartOptions="@(new ChartOptions { 
                                      YAxisTicks = 5, 
                                      ShowLegend = false,
                                      ChartPalette = new string[] { "#6366f1" }
                                  })" />
                    </div>
                </div>

                <div class="col-6">
                    <h4 class="text-center fw-bold mb-4" style="color:#1e293b">Salary Advance Requests</h4>
                    <div class="chart-box">
                        <MudChart ChartType="MudBlazor.ChartType.Bar"
                                  ChartSeries="@AdvanceSeries"
                                  XAxisLabels="@XAxisLabels"
                                  Width="100%" Height="350px"
                                  ChartOptions="@(new ChartOptions { 
                                      YAxisTicks = 5, 
                                      ShowLegend = false,
                                      ChartPalette = new string[] { "#14b8a6" }
                                  })" />
                    </div>
                </div>
            </div>
        </div>

        @* PAGE 3: ETHNICITY & LEGAL *@
<div class="paper-sheet" style="position: relative;">
  <h2 class="section-header">03. Ethnicity Distribution (%)</h2>
            <div class="row mt-12">
                <div class="col-12">
                    <div class="pa-6">
                        @if (Stats.Ethnicities.Any())
                        {
                            <div class="row">
                                @foreach (var eth in Stats.Ethnicities.OrderByDescending(x => x.Percentage))
                                {
                                    <div class="col-6 mb-5">
                                        <div class="d-flex justify-content-between mb-1">
                                            <span class="progress-label">@eth.Name</span>
                                            <span class="progress-val">@eth.Percentage%</span>
                                        </div>
                                        <MudProgressLinear Color="MudBlazor.Color.Info" Value="@eth.Percentage" Size="MudBlazor.Size.Medium" Style="height:8px; border-radius:4px;" />
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="pa-12 text-center border-dashed" style="color:#94a3b8; border: 2px dashed #e2e8f0; border-radius:12px;">
                                NO ETHNICITY DATA FOUND IN DATABASE
                            </div>
                        }
                    </div>
                </div>
            </div>
<div style="position: absolute; bottom: 20mm; left: 0; right: 0; text-align: center; border-top: 1px solid #e2e8f0; padding-top: 20px; color: #94a3b8; font-size: 0.75rem; margin: 0 20mm;">
        Generated by HR PRO MAX SYSTEM • Confidential Executive Document
    </div>
        </div>
    </div>
</DialogContent>
  <DialogActions>
    <MudButton Variant="MudBlazor.Variant.Outlined" OnClick="Cancel">Close Preview</MudButton>
    <MudButton Color="MudBlazor.Color.Error" Variant="MudBlazor.Variant.Filled" StartIcon="@Icons.Material.Filled.PictureAsPdf" OnClick="DownloadPdf">Export to PDF</MudButton>
  </DialogActions>
</MudDialog>

@code {
  [CascadingParameter] MudBlazor.IMudDialogInstance? MudDialog { get; set; }
  [Parameter] public DashboardStatsDTO Stats { get; set; } = new();

  [Parameter] public double[] GenderData { get; set; } = { 0, 0 };
    [Parameter] public string[] GenderLabels { get; set; } = { "Male", "Female" };
    [Parameter] public double[] AgeData { get; set; } = { 0, 0, 0 };
    [Parameter] public string[] AgeLabels { get; set; } = { "Gen Z", "Millennials", "Boomers" };

  [Parameter] public int PermanentCount { get; set; }
  [Parameter] public int ContractCount { get; set; }
  [Parameter] public int InternCount { get; set; }

  [Parameter] public double[] EthnicityData { get; set; } = Array.Empty<double>();
  [Parameter] public string[] EthnicityLabels { get; set; } = Array.Empty<string>();
  [Inject] private IJSRuntime? JS { get; set; }
  private void Cancel() => MudDialog?.Cancel();
private async Task DownloadPdf() => await JS!.InvokeVoidAsync("downloadReportAsPdf");

  //-=================================MONTHLY TRENDS DATA TRANSFORMATION (LEAVE & ADVANCE)=================================-
  // Define the labels for the X-Axis
 // Define the labels for the X-Axis
private string[] XAxisLabels = { "Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec" };

// Prepare the Series - Single series per chart for perfect alignment
private List<ChartSeries> LeaveSeries => new List<ChartSeries>
{
    new ChartSeries { Name = "Leaves", Data = Stats.MonthlyLeavesTrend ?? new double[12] }
};

private List<ChartSeries> AdvanceSeries => new List<ChartSeries>
{
    new ChartSeries { Name = "Advances", Data = Stats.MonthlyAdvancesTrend ?? new double[12] }
};
}