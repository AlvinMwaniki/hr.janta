@code {

  private DashboardTotals? totals;
  [CascadingParameter]
  private Task<AuthenticationState> AuthStateTask { get; set; } = default!;
  private AdvanceChartDataDto AdvanceChartData = new();
  private List<UnifiedRequestDto> myApplications = new();
  private ClaimsPrincipal? _user = default!;
  private List<UnifiedRequestDto> adminPendingList = new();
  private List<UnifiedRequestDto> atsPendingList = new();
  private int activePage = 1;
  private bool isAutoCycling = false;
  private System.Timers.Timer? cycleTimer;
  @inject HR.Services.Interfaces.IJobApplicationService JobAppService
  private void SetPage(int page) => activePage = page;
  private bool _firstRenderComplete = false;
  // This is the "Modern" reactive property. It always knows the truth.
  private bool ShowEmployeeView =>
      !(_user?.HasClaim("Permission", AppPermissions.ViewAdminDashboard) ?? false)
      || Impersonation.IsInEmployeeView
      || Impersonation.IsImpersonating;

  protected override async Task OnInitializedAsync()
  {
    var authState = await AuthStateTask;
    _user = authState.User;

    // Load everything ONCE before first render
    await LoadDashboardSafeAsync();
    totals!.LeaveBalance = await DashboardService.GetMyLeaveBalanceAsync();
    totals.LeavesTaken = await DashboardService.GetMyLeavesTakenAsync();

    myApplications = await DashboardService.GetMyRecentApplicationsAsync(5);

    if (!ShowEmployeeView)
    {
      adminPendingList = await DashboardService.GetAllPendingApplicationsAsync();
      atsPendingList = await JobAppService.GetNewApplicationsForWidgetAsync();
    }

    _firstRenderComplete = true;
  }
  protected override Task OnAfterRenderAsync(bool firstRender)
  {
    if (firstRender)
    {
      NotificationService.OnLeaveUpdated += HandleLeaveNotification;
      AppNotifyService.OnNotificationReceived += HandleGeneralChange;
      Impersonation.OnStateChanged += HandleStateChange;

      StartCycle();
      _ = Task.Run(() => ContractService.ProcessExpiredContractsAsync());
    }

    return Task.CompletedTask;
  }

  private async Task RefreshAll()
  {
    await LoadDashboardSafeAsync();
    myApplications = await DashboardService.GetMyRecentApplicationsAsync(5);
    if (!ShowEmployeeView)
    {
      adminPendingList = await DashboardService.GetAllPendingApplicationsAsync();
      atsPendingList = await JobAppService.GetNewApplicationsForWidgetAsync();
    }
    if (_firstRenderComplete)
      StateHasChanged();

  }
  private async Task HandleAdminAction((UnifiedRequestDto Request, HR.Core.Enums.LeaveStatus Status) args)
  {
    bool success = false;
    if (args.Request.RequestType == "Leave")
    {
      success = await LeaveService.ReviewLeaveRequestAsync(args.Request.Id, args.Status);
    }
    else if (args.Request.RequestType == "Advance")
    {
      // success = await AdvanceService.ReviewAdvanceRequestAsync(args.Request.Id, args.Status);
    }

    if (success) await RefreshAll();
  }
  private void HandleAdminAction(UnifiedRequestDto request)
{
    if (request.RequestType == "JobApp")
    {
        Nav.NavigateTo($"/admin/recruitment/applications?reviewId={request.Id}");
    }
}
  private async Task HandleCancelRequest(UnifiedRequestDto request)
  {
    bool success = false;

    if (request.RequestType == "Leave")
    {
      success = await LeaveService.CancelLeaveRequestAsync(request.Id);
    }
    else if (request.RequestType == "Advance")
    {
      //success = await AdvanceService.CancelAdvanceRequestAsync(request.Id);
    }

    if (success)
    {
      // Refresh everything to show the new status and updated balances
      await RefreshAll();
    }
  }

  // This runs whenever an Admin approves/rejects a leave
  private async void HandleLeaveNotification(string userId, string message)
  {
    var currentUserId = _user?.FindFirst(ClaimTypes.NameIdentifier)?.Value;

    // Only refresh if the notification is for the logged-in user
    if (userId == currentUserId)
    {
      await InvokeAsync(async () =>
     {
       // 1. Play the "Ding" sound
       await JS.InvokeVoidAsync("playNotificationSound");

       // 2. Refresh the lists
       await RefreshAll();
     });
    }
  }

  private void HandleStateChange()
  {
    // Re-renders the UI immediately when the service changes
    InvokeAsync(StateHasChanged);
  }
  public void Dispose()
  {
    // Professional cleanup to prevent memory leaks
    Impersonation.OnStateChanged -= HandleStateChange;
    NotificationService.OnLeaveUpdated -= HandleLeaveNotification;
    AppNotifyService.OnNotificationReceived -= HandleGeneralChange;
  }

  private async Task LoadDashboardSafeAsync()
  {
    try
    {
      totals = await LoadDashboardAsync();
    }
    catch (Exception ex)
    {
      Console.WriteLine($"Error loading dashboard data: {ex.Message}");
      totals = new DashboardTotals(); // fallback
    }
  }

  private async Task<DashboardTotals> LoadDashboardAsync()
  {
    try
    {
      return new DashboardTotals
      {
        Employees = await DashboardService.GetTotalEmployeesAsync(),
        Departments = await DashboardService.GetTotalDepartmentsAsync(),
        Leaves = await DashboardService.GetTotalLeavesAsync(),
        Advances = await DashboardService.GetTotalAdvancesAsync(),
        OnLeave = await DashboardService.GetEmployeesOnLeaveAsync(),
        NotOnLeave = await DashboardService.GetEmployeesNotOnLeaveAsync(),
        LeaveBalance = await DashboardService.GetMyLeaveBalanceAsync(), // Parameter REMOVED
        LeavesTaken = await DashboardService.GetMyLeavesTakenAsync(),
        PendingTasks = await DashboardService.GetMyPendingTasksAsync(),
        JobTitle = await DashboardService.GetMyJobTitleAsync(),
        Department = await DashboardService.GetMyDepartmentAsync(),
        AdvanceChartData = await DashboardService.GetAdvanceStatusChartDataAsync(),
        LeaveChartData = await DashboardService.GetLeaveStatusChartDataAsync()
        //LastPayslipDate = await DashboardService.GetMyLastPayslipDateAsync()
      };
    }
    catch (Exception ex)
    {
      Console.WriteLine("🔥 FATAL DASHBOARD ERROR:");
      Console.WriteLine(ex.ToString());
      throw;
    }
  }

 
    private bool showAnalyticsPage = false;

    private void TogglePage()
    {
        showAnalyticsPage = !showAnalyticsPage;
    }


  // Helper to determine if the Employee Dashboard View should be visible
  private bool ShouldShowEmployeeView(System.Security.Claims.ClaimsPrincipal user)
  {
    // Condition 1: Is a regular Employee (i.e., NOT an Admin)
    bool isRegularEmployee = !user.IsInRole(AppRoles.Admin);

    // Condition 2: Is an Admin currently impersonating
    // The Impersonation service (which is injected at the component level) is accessible here.
    bool isImpersonatingAdmin = user.IsInRole(AppRoles.Admin) && Impersonation.IsImpersonating;

    return isRegularEmployee || isImpersonatingAdmin;
  }
  private string GetPageTitle() => activePage switch
  {
    1 => "Operational Overview",
    2 => "Pending Staff Approvals",
    3 => "Analytical Trends",
    _ => "Dashboard"
  };
  //=========== AUTO-CYCLING LOGIC ==========KA SLIDER==========

  private void ToggleAutoCycle()
  {
    isAutoCycling = !isAutoCycling;

    if (isAutoCycling)
    {
      // 5 seconds is usually best for "glanceable" MIS dashboards
      cycleTimer = new System.Timers.Timer(5000);
      cycleTimer.Elapsed += OnCycleTimerElapsed;
      cycleTimer.AutoReset = true;
      cycleTimer.Enabled = true;
    }
    else
    {
      if (cycleTimer != null)
      {
        cycleTimer.Enabled = false;
        cycleTimer.Elapsed -= OnCycleTimerElapsed;
        cycleTimer.Dispose();
        cycleTimer = null;
      }
    }
  }
  private void StartCycle()
  {
    if (cycleTimer == null)
    {
      cycleTimer = new System.Timers.Timer(7000); // 7 seconds
      cycleTimer.Elapsed += OnCycleTimerElapsed;
      cycleTimer.AutoReset = true;
      cycleTimer.Start();
      isAutoCycling = true;
    }
  }

  private void StopCycle()
  {
    if (cycleTimer != null)
    {
      cycleTimer.Stop();
      cycleTimer.Elapsed -= OnCycleTimerElapsed;
      cycleTimer.Dispose();
      cycleTimer = null;
      isAutoCycling = false;
    }
  }
  private async void OnCycleTimerElapsed(object? sender, System.Timers.ElapsedEventArgs e)
  {
    // Important: Use InvokeAsync to tell Blazor to update the UI from a background thread
    await InvokeAsync(() =>
    {
      activePage = activePage >= 3 ? 1 : activePage + 1;
      StateHasChanged();
    });
  }
  private void HandleGeneralChange()
  {
    InvokeAsync(async () =>
    {
      // 1. Play Sound
      await JS.InvokeVoidAsync("playNotificationSound");

      // 2. Refresh Widget Lists
      await RefreshAll();

      StateHasChanged();
    });
  }
}
