@page "/employees/success"
@inject NavigationManager Navigation

@rendermode InteractiveServer

<div class="container text-center py-5">
  <div class="card p-5 shadow-lg mx-auto" style="max-width: 500px; border-radius: 15px;">

    <div class="mb-4" style="margin: 0 auto; width: 100px; height: 100px;">
      <svg xmlns="http://www.w3.org/2000/svg"
           viewBox="0 0 52 52"
           style="background-color: #d4edda; border-radius: 50%;">
        <circle cx="26" cy="26" r="25" fill="none" stroke="#28a745" stroke-width="3" />
        <path fill="none" stroke="#28a745" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"
              d="M14.1 27.2l7.1 7.2 16.7-16.8" />
      </svg>
    </div>

    <h2 class="card-title text-success mb-3">
      Employee Created Successfully!
    </h2>

    <p class="card-text fs-5 text-muted">
      The new employee record has been saved to the database.
    </p>

    <p class="mt-4 text-secondary">
      Redirecting to the <strong>Dashboard</strong> in @secondsRemaining seconds...
    </p>

    <div class="mt-4">
      <button class="btn btn-primary mb-2" @onclick="GoToContract">
        Generate Employment Contract
      </button>

      <button class="btn btn-outline-secondary btn-sm" @onclick="RedirectNow">
        Go to Dashboard Now
      </button>
    </div>
  </div>
</div>

@code {
  private const int RedirectDelaySeconds = 25;
  private int secondsRemaining = RedirectDelaySeconds;
  private Timer? timer;

  protected override void OnInitialized()
  {
    timer = new Timer(Tick, null, 1000, 1000);
  }

  private void Tick(object? state)
  {
    if (secondsRemaining > 0)
    {
      secondsRemaining--;
      InvokeAsync(StateHasChanged);
    }
    else
    {
      timer?.Dispose();
      RedirectNow();
    }
  }

  private void RedirectNow()
  {
    timer?.Dispose();

    try
    {
      Navigation.NavigateTo("/dashboard", forceLoad: true);
    }
    catch (Microsoft.AspNetCore.Components.NavigationException)
    {
    }
  }

  private void GoToContract()
  {
    Navigation.NavigateTo("/employees/EmployeeContract");
  }

  public void Dispose()
  {
    timer?.Dispose();
  }
}