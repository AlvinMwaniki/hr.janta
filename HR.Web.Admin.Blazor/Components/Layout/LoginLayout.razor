@inherits LayoutComponentBase

<div class="login-page-container">
  <div class="login-card shadow-lg">
    <div class="row g-0 h-100">

      <div class="col-md-5 login-portal-panel">
        <div class="portal-content">

          <h1 class="portal-title">HR Master ProX</h1>

          <ul class="portal-features list-unstyled">
            <li><span class="oi oi-check"></span> Employee Analytics</li>
            <li><span class="oi oi-calendar"></span> Online Scheduling</li>
            <li><span class="oi oi-spreadsheet"></span> Resulting & Reporting</li>
            <li><span class="oi oi-shield"></span> Safety Compliance</li>
            <li><span class="oi oi-tags"></span> Employee Onboarding</li>
            <li><span class="oi oi-credit-card"></span> Payroll & Invoicing</li>
          </ul>

        </div>
      </div>

      <div class="col-md-7 login-form-panel">
        @Body
      </div>

    </div>
  </div>
</div>