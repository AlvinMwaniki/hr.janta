                  <path d="M100,30 Q85,5 70,20 T40,10 T0,25" fill="none" stroke="white" stroke-width="3" stroke-linecap="round" />
                </svg>
              </div>
              <i class="fas fa-users prox-metric-decor"></i>
            </div>

        </div>
    <!-- Total Departments Card -->
        <div class="col-md-3">
            <div class="card prox-metric-card prox-bg-glass">
              <div class="card-body">
                <div class="prox-metric-title">Total Departments</div>
                <div class="prox-metric-value">@totals.Departments</div>
                <small class="opacity-75">Pending Updates</small>
              </div>
              <i class="fas fa-building prox-metric-decor"></i>
            </div>

        </div>

    <!-- Leaves Card -->
        <div class="col-md-3">
            <div class="card prox-metric-card prox-bg-soft">
              <div class="card-body">
                <div class="prox-metric-title">Leave Requests</div>
                <div class="prox-metric-value">@totals.Leaves</div>
                <small class="opacity-75">4 Pending</small>
              </div>
              <i class="fas fa-plane-departure prox-metric-decor"></i>
            <div style="position: absolute; bottom: 0; right: 0; width: 60%; opacity: 0.4;">
              <svg viewBox="0 0 100 40" preserveAspectRatio="none" style="width: 100%; height: 50px;">
                <path d="M0,35 Q20,35 40,15 T80,25 T100,5" fill="none" stroke="white" stroke-width="3" stroke-linecap="round" />
              </svg>
            </div>
          </div>
        </div>

    <!-- Advances Card -->
        <div class="col-md-3">
            <div class="card prox-metric-card">
              <div class="card-body">
                <div class="prox-metric-title">Advance Payments</div>
                <div class="prox-metric-value">@totals.Advances</div>
                <small class="opacity-75">Outstanding</small>
              </div>
              <i class="fas fa-money-bill-wave prox-metric-decor"></i>
            </div>

        </div>
      </div>
<!-- Charts -->
        <div class="d-flex justify-content-between align-items-center mt-3 mb-2">
          <h4 class="fw-bold .prox-header-text mb-0">@GetPageTitle()</h4>

          <div class="d-flex align-items-center p-1 rounded-pill shadow-sm prox-pill-container">
            <ul class="nav nav-pills ms-auto" id="pills-tab" role="tablist">
              <li class="nav-item">
                <button class="nav-link py-1 px-3 rounded-pill @(activePage == 1 ? "active shadow-sm" : "text-muted")"
                        @onclick="() => SetPage(1)">
                  Overview
                </button>
              </li>
              <li class="nav-item">
                <button class="nav-link py-1 px-3 rounded-pill @(activePage == 2 ? "active shadow-sm" : "text-muted")"
                        @onclick="() => SetPage(2)">
                  Approvals @if(adminPendingList?.Any() == true) {
                  <span class="badge bg-danger rounded-pill ms-1">@adminPendingList.Count</span>
                }
              </button>
            </li>
            <li class="nav-item">
              <button class="nav-link py-1 px-3 rounded-pill @(activePage == 3 ? "active shadow-sm" : "text-muted")"
                      @onclick="() => SetPage(3)">
                Job Applications
              </button>
            </li>
            <li class="nav-item">
              <button class="nav-link py-1 px-3 rounded-pill @(activePage == 4 ? "active shadow-sm" : "text-muted")"
                      @onclick="() => SetPage(4)">
                Trends
              </button>
            </li>
          </ul>
        </div>
      </div>

      <div class="prox-glass-stage shadow-lg rounded-4 mb-5 p-4"
            @onmouseenter="StopCycle"
           @onmouseleave="StartCycle">
        
        @if (activePage == 1)
        {
          <div class="row g-3 animate-fade-in">
            <div class="col-md-6">
              <div class="card h-100 border-0 shadow-sm rounded-4 prox-dark-card">
                <div class="card-body">
                  <h6 class="prox-sub-label fw-bold mb-3"><i class="fas fa-chart-pie me-2 text-info"></i>Leaves Distribution</h6>
                  <LeaveChartCard LeaveData="@totals.LeaveChartData" />
                </div>
              </div>
            </div>
            <div class="col-md-6">
              <div class="card h-100 border-0 shadow-sm rounded-4 prox-dark-card">
                <div class="card-body">
                  <h6 class="prox-sub-label fw-bold mb-3"><i class="fas fa-chart-line me-2 text-primary"></i>Salary Advance Insights</h6>
                  <AdvanceChartCard AdvanceData="@totals.AdvanceChartData" />
                </div>
              </div>
            </div>
          </div>
        }
        else if (activePage == 2)
        {
          <div class="animate-fade-in h-100">
            <div class="card border-0 shadow-sm rounded-4 prox-dark-card h-100">
              <div class="card-body p-0">
                <AdminApprovalsWidget Applications="adminPendingList" OnAction="HandleAdminAction" />
              </div>
            </div>
          </div>
        }
        else if (activePage == 3)
        {
          <div class="animate-fade-in h-100">
            <div class="card border-0 shadow-sm rounded-4 prox-dark-card h-100">
              <div class="card-body p-0">
                <ATSApplicationsWidget Applications="atsPendingList" OnAction="HandleAdminAction" />
              </div>
            </div>
          </div>
        }
        else if (activePage == 4)
        {
          <div class="animate-fade-in text-center py-5 prox-dark-card rounded-4">
            <i class="fas fa-chart-bar fa-4x text-primary opacity-25 mb-3"></i>
            <h5 class="fw-bold">Strategic Growth Analytics</h5>
            <p class="text-muted">Attrition rates and hiring trends will appear here.</p>
          </div>
        }
      </div>
    </Authorized>
  </AuthorizeView>}
  // ===========END OF ADMIN DASHBOARD VIEW===========

  // ===========EMPLOYEE DASHBOARD VIEW (Visible to all)===========
  @if (ShowEmployeeView){
    <AuthorizeView Policy="@AppPermissions.ViewEmployeeDashboard">
      <Authorized>
      @* === 1. WELCOME HEADER (Full Width) === *@
<div class="row mb-4">
         <div class="col-12">
    <div class="p-3 rounded-3 shadow-sm" style="min-height: 50px;">
        <div class="d-flex align-items-center gap-3">
            <!-- Job Title Badge -->
            <span class="badge bg-info text-dark fs-6 fw-semibold">
                <i class="fas fa-briefcase me-1"></i> @totals.JobTitle
            </span>

            <!-- Department Badge -->
            <span class="badge bg-primary fs-6 fw-semibold">
                <i class="fas fa-building me-1"></i> @totals.Department
            </span>
        </div>
    </div>
</div>
    </div>


    @* === 2. MAIN SYMMETRIC DASHBOARD ROW === *@
    <div class="row g-4">
        

        @* === LEFT SECTION: 3 METRIC CARDS (col-lg-6) === *@
        <div class="col-lg-8">
            <div class="card shadow-lg p-3 h-100">
                <div class="card-body d-flex flex-column p-0">

                <h5 class="mb-4 text-dark border-bottom pb-2">@context.User.Identity?.Name! Hub</h5>
                    
                    @* --- Key Metric Cards (3-column layout) --- *@
                    <div class="row g-3 flex-grow-1">
                @{
                  var totalLeave = HR.Core.HRConstants.AnnualLeaveDaysLimit;
                  var balance = totals.LeaveBalance;
                  var used = totalLeave - balance;
                  var usedPercent = totalLeave == 0 ? 0 : (double)used / totalLeave * 100;

                  var leaveClass = "prox-leave-ok";

                  if (balance <= 5)
                  {
                    leaveClass = "prox-leave-critical";
                  }
                  else if (balance <= 10)
                  {
                    leaveClass = "prox-leave-low";
                  }
                }

                <div class="col-md-4">
                  <div class="card prox-metric-card prox-employee-card @leaveClass h-100">
                    <div class="card-body">

                      <div class="prox-metric-title">
                        <i class="fas fa-plane-departure me-2"></i> Leave Balance
                      </div>

                      <div class="prox-metric-value">
                        @balance
                      </div>

                      <small class="opacity-75">
                        @used of @totalLeave days used
                      </small>

                      <!-- Tiny progress bar -->
                      <div class="prox-progress mt-2">
                        <div class="prox-progress-bar" style="width:@usedPercent%"></div>
                      </div>

                    </div>

                    <i class="fas fa-plane-departure prox-metric-decor"></i>
                  </div>
                </div>



                <div class="col-md-4">
                  <div class="card prox-metric-card prox-employee-card h-100">
                    <div class="card-body">
                      <div class="prox-metric-title">
                        <i class="fas fa-calendar-check me-2"></i> Leave Taken
                      </div>
                      <div class="prox-metric-value">
                        @totals.LeavesTaken
                      </div>
                      <small class="opacity-75">Days YTD</small>
                    </div>
                    <i class="fas fa-calendar-check prox-metric-decor"></i>
                  </div>
                </div>


                <div class="col-md-4">
                  <div class="card prox-metric-card prox-employee-card h-100">
                    <div class="card-body">
                      <div class="prox-metric-title">
                        <i class="fas fa-clipboard-list me-2"></i> Pending Tasks
                      </div>
                      <div class="prox-metric-value">
                        @totals.PendingTasks
                      </div>
                      <small class="opacity-75">Required Action</small>
                    </div>
                    <i class="fas fa-clipboard-list prox-metric-decor"></i>
                  </div>
                </div>


              </div>
                </div>
            </div>
        </div>

        @* === RIGHT SECTION: CALL-TO-ACTIONS (col-lg-6 - Unchanged, remains symmetrical) === *@
        <div class="col-lg-4">
            <div class="card shadow-lg p-3 h-100">
                <div class="card-body d-flex flex-column justify-content-center p-2">
                    <h5 class="card-title text-success mb-4 text-center border-bottom pb-2">Quick Actions & Documents</h5>
                    
                    @* --- Action 1: Payslip (Unchanged) --- *@
                    <a href="/payslips" class="action-btn-link mb-3 text-decoration-none">
                        <div class="d-flex align-items-center p-3 rounded-3 shadow-sm bg-white hover-zoom">
                            <i class="fas fa-money-bill-wave fa-lg text-secondary me-3"></i>
                            <div>
                                <strong class="d-block">View Last Payslip</strong>
                                <small class="text-muted">Download your recent salary statement.</small>
                            </div>
                            <i class="fas fa-chevron-right ms-auto text-muted"></i>
                        </div>
                    </a>

                    @* --- Action 2: Submit Leave (Unchanged) --- *@
                    <AuthorizeView Policy="@AppPermissions.SubmitLeave">
                  <Authorized Context="submitContext">
                    <a href="/leave/submit" class="action-btn-link text-decoration-none">
                                <div class="d-flex align-items-center p-3 rounded-3 shadow-sm bg-white hover-zoom">
                                    <i class="fas fa-calendar-plus fa-lg text-success me-3"></i>
                                    <div>
                                        <strong class="d-block">Submit Leave Request</strong>
                                        <small class="text-muted">Need a day off? Click here to apply.</small>
                                    </div>
