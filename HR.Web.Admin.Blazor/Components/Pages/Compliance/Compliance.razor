@page "/compliance"

<div class="container my-4">
  <h2 class="mb-4">
    <i class="fas fa-balance-scale-right me-2"></i> Compliance Dashboard
  </h2>

  <!-- Summary Cards -->
  <div class="row g-3 mb-4">
    <div class="col-md-3">
      <div class="card text-white bg-success shadow-sm">
        <div class="card-body">
          <h5 class="card-title">Policies Up-to-Date</h5>
          <h3>12</h3>
        </div>
      </div>
    </div>

    <div class="col-md-3">
      <div class="card text-white bg-warning shadow-sm">
        <div class="card-body">
          <h5 class="card-title">Pending Audits</h5>
          <h3>3</h3>
        </div>
      </div>
    </div>

    <div class="col-md-3">
      <div class="card text-white bg-danger shadow-sm">
        <div class="card-body">
          <h5 class="card-title">Violations</h5>
          <h3>1</h3>
        </div>
      </div>
    </div>

    <div class="col-md-3">
      <div class="card text-white bg-primary shadow-sm">
        <div class="card-body">
          <h5 class="card-title">Total Checks</h5>
          <h3>16</h3>
        </div>
      </div>
    </div>
  </div>

  <!-- Compliance Records Table -->
  <div class="card shadow-sm">
    <div class="card-body">
      <h5 class="card-title mb-3">Compliance Records</h5>

      <table class="table table-striped table-hover">
        <thead>
          <tr>
            <th>Policy</th>
            <th>Status</th>
            <th>Last Reviewed</th>
            <th>Next Review</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Data Protection</td>
            <td><span class="badge bg-success">Compliant</span></td>
            <td>2025-12-01</td>
            <td>2026-06-01</td>
            <td>
              <button class="btn btn-sm btn-outline-primary">
                <i class="fas fa-eye me-1"></i> View
              </button>
            </td>
          </tr>
          <tr>
            <td>Workplace Safety</td>
            <td><span class="badge bg-warning">Pending</span></td>
            <td>2025-11-15</td>
            <td>2026-05-15</td>
            <td>
              <button class="btn btn-sm btn-outline-primary">
                <i class="fas fa-eye me-1"></i> View
              </button>
            </td>
          </tr>
          <tr>
            <td>HR Policies</td>
            <td><span class="badge bg-success">Compliant</span></td>
            <td>2025-12-10</td>
            <td>2026-06-10</td>
            <td>
              <button class="btn btn-sm btn-outline-primary">
                <i class="fas fa-eye me-1"></i> View
              </button>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</div>
