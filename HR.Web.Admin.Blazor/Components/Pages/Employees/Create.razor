@page "/employees/create"
@using HR.Data
@using HR.Services.Services
@inject HRDbContext Db
@inject NavigationManager Navigation
@inject EmployeeTempService TempService
@rendermode InteractiveServer
@using HR.Data.Models.Employees
@using HR.Data.Models.Departments
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Forms
@using HR.Data.Models.Country;
@using HR.Data.Models.County;

@inject IJSRuntime JS


 <div class="d-flex justify-content-between align-items-center">
<h3>Create Employee</h3>
  <button type="button" class="btn btn-sm btn-outline-danger" @onclick="ExitForm">
    <i class="fas fa-times me-1"></i> Exit
  </button>
</div>

<EditForm Model="@TempService.TempEmployee" OnValidSubmit="Save" OnInvalidSubmit="OnInvalidSubmit" FormName="Step1">
  <DataAnnotationsValidator />
  <!--IMAGE UPLOAD-->
  <div class="form-card text-center mb-4 shadow-sm p-3">
    <h3 class="form-section-title" style="color: #2596be; font-weight: bold;">Employee Photo</h3>
  <div class="d-flex flex-column align-items-center">
    <div style="position: relative; width: 160px; height: 160px; margin-bottom: 20px;">

      <div style="width: 100%; height: 100%; border-radius: 50%; border: 4px solid #2596be; overflow: hidden; display: flex; align-items: center; justify-content: center; background: #f8f9fa; box-shadow: 0 4px 10px rgba(0,0,0,0.1);">
        @if (TempService.TempEmployee.Photo != null)
        {
          <img src="@TempService.TempEmployee.PhotoBase64"
               style="width: 100%; height: 100%; object-fit: cover;" />
        }
        else
        {
          <i class="fas fa-camera fa-3x text-muted"></i>
        }
      </div>
      @if (TempService.TempEmployee.Photo != null)
      {
        <button type="button" @onclick="RemoveImage"
                class="btn btn-secondary shadow-sm"
                style="position: absolute; top: 0; right: 0; border-radius: 50%; width: 32px; height: 32px; padding: 0; display: flex; align-items: center; justify-content: center; border: 2px solid white; z-index: 10;"
                title="Remove Image">
          <i class="fas fa-times" style="font-size: 11px;"></i>
        </button>
      }
    </div>

      <div class="col-md-8">
        @* We use @ref to clear the input manually from C# *@
        <input type="file" @ref="fileInput" id="profileInput" accept="image/*"
               class="form-control" required
               onchange="window.processProfileImage(this)" />

      <div class="mt-2 d-flex flex-column align-items-center">
        <small class="text-muted d-block">
            <i class="fas fa-magic"></i> AI automatically detects and centers the face Upload Headshot Photo.
          </small>
          @if (TempService.TempEmployee.Photo == null)
          {
            <span class="badge bg-warning text-dark">Required</span>
          }
        </div>
      </div>
    </div>
  </div>

  <!--Basic Info-->

  <div class="form-card">

    <!-- Row 1: Employee Code -->
    <div class="row form-row mb-2">
      <div class="col-md-4">
        <label class="prox-header-text form-label">Employee Code</label>
        <InputText @bind-Value="TempService.TempEmployee.EmployeeCode" class="form-control" />
      </div>
    </div>

    <!-- Row 2: First, Middle, Last Name -->
    <div class="row form-row mb-2">
      <div class="col-md-4">
        <label class="prox-header-text form-label">First Name</label>
        <InputText @bind-Value="TempService.TempEmployee.FirstName" class="form-control" />
        <ValidationMessage For="@(() => TempService.TempEmployee.FirstName)" />
      </div>
      <div class="col-md-4">
        <label class="prox-header-text form-label">Middle Name</label>
        <InputText @bind-Value="TempService.TempEmployee.MiddleName" class="form-control" />
      </div>
      <div class="col-md-4">
        <label class="prox-header-text form-label">Last Name</label>
        <InputText @bind-Value="TempService.TempEmployee.LastName" class="form-control" />
        <ValidationMessage For="@(() => TempService.TempEmployee.LastName)" />

      </div>
    </div>

    <!-- Row 3: Email, Phone, Address -->
    <div class="row form-row mb-2">
      <div class="col-md-4">
        <label class="prox-header-text form-label">
          Email
          @if (isCheckingEmail)
          {
            <span class="spinner-border spinner-border-sm text-primary" role="status"></span>
          }
        </label>
        <div class="input-group">
          <span class="input-group-text @GetEmailStatusClass()">
            <i class="@GetEmailIconClass()"></i>
          </span>
        <InputText @bind-Value="TempService.TempEmployee.Email" @onblur="CheckEmailUniqueness" class="form-control" placeholder="yourmail@gmail.com"/>
        </div>
        @if (!string.IsNullOrEmpty(emailErrorMessage))
        {
          <div class="text-danger small mt-1 animated fadeIn">
            <i class="fas fa-exclamation-circle"></i> @emailErrorMessage
          </div>
        }
        <ValidationMessage For="@(() => TempService.TempEmployee.Email)" />
      </div>

      <div class="col-md-4">
        <label class="prox-header-text fw-bold">Phone Number</label>
        <div class="input-group mb-3">
          <button class="btn btn-light border-secondary-subtle dropdown-toggle d-flex align-items-center"
          type="button" data-bs-toggle="dropdown" aria-expanded="false" style="min-width: 90px;">
            @if (selectedCountry != null)
            {
              <img src="@selectedCountry.FlagUrl" class="me-2" style="width: 20px; height: 14px; border: 1px solid #dee2e6;" />
              <span class="fw-bold">@selectedCountry.IsoCode</span>
            }
          </button>

          <ul class="dropdown-menu shadow" style="max-height: 300px; overflow-y: auto;">
            @foreach (var c in countries.OrderBy(x => x.Name))
            {
              <li>
                <button type="button" class="dropdown-item d-flex align-items-center" @onclick="() => SelectCountry(c)">
                  <img src="@c.FlagUrl" class="me-2" style="width: 20px; border: 1px solid #eee;" />
                  <span>@c.Name (@c.DialCode)</span>
                </button>
              </li>
            }
          </ul>

          <InputText @bind-Value="TempService.TempEmployee.Phone"
                     class="form-control"
                     placeholder="712 345 678" 
                     maxlength="10" />
        </div>
        <ValidationMessage For="@(() => TempService.TempEmployee.Phone)" class="text-danger small" />
      </div>

      <div class="col-md-4">
        <label class="prox-header-text form-label fw-bold">County of Residence</label>
        <select class="form-select"
                style="color: @(TempService.TempEmployee.CountyId == null ? "#989A9C" : "var(--text-main, inherit)");"
                value="@TempService.TempEmployee.CountyId"
                @onchange="HandleCountyChange" >
          <option value="" disabled selected hidden>-- Select County --</option>         
          @if (countiesList != null)
          {
            @foreach (var c in countiesList)
            {
              <option value="@c.Id">@c.Name</option>
            }
          }
        </select>
        <ValidationMessage For="@(() => TempService.TempEmployee.CountyId)" />
      </div>
    </div>
    <!-- Row 3.5: Subcounty, Estate, pobox -->
    <div class="row mb-3">
      <div class="col-md-4">
        <label class="prox-header-text form-label fw-bold">Sub-County / Area</label>
        <select @bind="TempService.TempEmployee.SubCountyId" class="form-select"
                style="color: @(TempService.TempEmployee.SubCountyId == null ? "#989A9C" : "var(--text-main, inherit)");">
          
          <option value="" disabled selected hidden>-- Select Sub-County --</option>
          @if (filteredSubCounties != null)
          {
            @foreach (var sub in filteredSubCounties)
            {
              <option value="@sub.Id">@sub.Name</option>
            }
          }
        </select>
        <ValidationMessage For="@(() => TempService.TempEmployee.SubCountyId)" />
      </div>

      <div class="col-md-4">
        <label class="prox-header-text form-label fw-bold">Estate / Street</label>
        <InputText @bind-Value="TempService.TempEmployee.Estate" class="form-control" />
      </div>

      <div class="col-md-4">
        <label class="prox-header-text form-label fw-bold">P.O. Box</label>
        <InputText @bind-Value="TempService.TempEmployee.POBox" class="form-control" />
      </div>
    </div>
    <!-- Row 4: DOB, National ID, Gender -->
    <div class="row form-row mb-2">
      <div class="col-md-4">
        <label class="prox-header-text form-label">Date of Birth</label>
       <InputDate @bind-Value="TempService.TempEmployee.DOB" 
           class="form-control"
           
           />
        <ValidationMessage For="@(() => TempService.TempEmployee.DOB)" />

      </div>
      <div class="col-md-4">
        <label class="prox-header-text form-label">National ID</label>
        <InputText @bind-Value="TempService.TempEmployee.NationalID" class="form-control"
                   style="@(string.IsNullOrEmpty(TempService.TempEmployee.NationalID))" maxlength="9"
                   placeholder="Enter 9 digits" />
        <ValidationMessage For="@(() => TempService.TempEmployee.NationalID)" />

      </div>
      <div class="col-md-4">
        <label class="prox-header-text form-label">Gender</label>
        <InputSelect @bind-Value="TempService.TempEmployee.Gender"
                     class="form-control"
                     style="@(string.IsNullOrEmpty(TempService.TempEmployee.Gender))">

          <option  value="" selected hidden>Select Gender</option>
          <option value="Male">Male</option>
          <option value="Female">Female</option>
        </InputSelect>
        <ValidationMessage For="@(() => TempService.TempEmployee.Gender)" />

      </div>
    </div>

    <!-- Row 5: Job Title, Disability, Ethnicity -->
    <div class="row form-row mb-2">
      <div class="col-md-4">
        <label class="prox-header-text form-label">Job Title</label>
        <InputText @bind-Value="TempService.TempEmployee.JobTitle" class="form-control" />
        <ValidationMessage For="@(() => TempService.TempEmployee.JobTitle)" />

      </div>
      <div class="col-md-4">
        <label class="prox-header-text form-label font-weight-bold">Are you a Person with Disability?</label>
        <InputSelect @bind-Value="TempService.TempEmployee.Disability" class="form-control"
                     style="@(string.IsNullOrEmpty(TempService.TempEmployee.Disability) )">

        >
          <option value="" selected hidden>Select Disability</option>
          <option value="No">No</option>
          <option value="Yes">Yes</option>
        </InputSelect>
      </div>

      @if (TempService.TempEmployee.Disability == "Yes")
      {
        <div class="row mt-3 border p-3 rounded">
          <div class="col-md-12 mb-3">
            <label class="prox-header-text form-label">Nature of Disability (Describe your condition)</label>
            <InputText @bind-Value="TempService.TempEmployee.DisabilityDetail!.DisabilityNature"
                       class="form-control" placeholder="e.g. Physical - Mobility Impairment" />
          </div>

          <div class="col-md-6">
            <label class="prox-header-text form-label">NCPWD Number</label>
            <InputText @bind-Value="TempService.TempEmployee.DisabilityDetail.NCPWD_Number"
                       class="form-control" />
          </div>

          <div class="col-md-6">
            <label class="prox-header-text form-label">KRA Exemption Number</label>
            <InputText @bind-Value="TempService.TempEmployee.DisabilityDetail.KRA_ExemptionNumber"
                       class="form-control" />
          </div>

          <div class="col-md-12 mt-3">
            <label class="prox-header-text form-label">Upload Exemption Certificate (PDF/Image)</label>
            <InputFile OnChange="HandleFileSelected" class="form-control" />
          </div>
        </div>
      }
      <div class="col-md-4">
        <label class="prox-header-text form-label">Ethnicity</label>
        <InputSelect @bind-Value="TempService.TempEmployee.EthnicityId" class="form-control"
                     style="@(TempService.TempEmployee.EthnicityId == null || TempService.TempEmployee.EthnicityId == Guid.Empty)">
          <option value=""selected hidden>Select Ethnicity</option>
          @if (ethnicities != null)
          {
            @foreach (var eth in ethnicities)
            {
              // We use eth.Id for the value and eth.Name for the display text
              <option value="@eth.Id">@eth.Name</option>
            }
          }
        </InputSelect>
        <ValidationMessage For="@(() => TempService.TempEmployee.EthnicityId)" />
      </div>
    </div>

    <!-- Row 6: Hire Date, Status, Department -->
    <div class="row form-row mb-2">
      <div class="col-md-4">
        <label class="prox-header-text form-label">Hire Date</label>
        <InputDate @bind-Value="TempService.TempEmployee.HireDate" class="form-control" />
        <ValidationMessage For="@(() => TempService.TempEmployee.HireDate)" />

      </div>

        <div class="col-md-4">
          <label class="prox-header-text form-label fw-bold">Contract Type</label>
          <InputSelect TValue="HR.Core.Enums.ContractType"
                       @bind-Value="TempService.TempEmployee.ContractType"
                       @bind-Value:after="OnTypeChanged"
                       class="form-control">
            @foreach (var type in Enum.GetValues(typeof(HR.Core.Enums.ContractType)))
            {
              <option value="@type">@type.ToString()</option>
            }
          </InputSelect>
          <ValidationMessage For="@(() => TempService.TempEmployee.ContractType)" />
        </div>

        @if (TempService.TempEmployee.ContractType != HR.Core.Enums.ContractType.Permanent)
        {
          <div class="col-md-8 animate__animated animate__fadeInRight">
            <div class="card shadow-sm border-primary" style="background-color: #f0f7ff; border-left: 5px solid #007bff !important;">
              <div class="card-body py-2">
                <div class="row align-items-center">
                  <div class="col-md-5">
                    <label class="form-label mb-1 small fw-bold">Set Duration</label>
                    <div class="input-group input-group-sm">
                      <input type="number" class="form-control"
                             @bind="durationValue"
                             @bind:event="oninput"
                             @bind:after="Calculate" />

                      <select class="form-select w-auto"
                              @bind="durationUnit"
                              @bind:after="Calculate">
                        <option value="Months">Months</option>
                        <option value="Years">Years</option>
                      </select>
                    </div>
                  </div>
                  <div class="col-md-7">
                    <label class="form-label mb-1 small fw-bold text-primary">Calculated End Date</label>
                    <div class="d-flex align-items-center">
                      <InputDate @bind-Value="TempService.TempEmployee.ContractEndDate"
                                 class="form-control form-control-sm fw-bold border-primary text-primary" />
                      <span class="ms-2 badge bg-primary text-white">Smart Mode</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        }

      <div class="col-md-4">
        <label class="prox-header-text form-label">Department</label>
        <InputSelect @bind-Value="TempService.TempEmployee.DepartmentId" class="form-control"
                     style="@(TempService.TempEmployee.DepartmentId == Guid.Empty)">
          <option value="" selected hidden>Select Department</option>
          @foreach (var d in departments)
          {
            <option value="@d.Id">@d.Name</option>
          }
        </InputSelect>
        <ValidationMessage For="@(() => TempService.TempEmployee.DepartmentId)" />

      </div>
    </div>

    <button type="submit" class="btn btn-primary">Save & Continue</button>
  </div>
</EditForm>


@code {
  // For phone country code selection
  List<Country> countries = new();
  List<County> countiesList = new();
  private List<SubCounty> filteredSubCounties = new();
  private Country? selectedCountry;
  private int durationValue;
  private string durationUnit = "Months";

  private void OnTypeChanged()
  {
    if (TempService.TempEmployee.ContractType == HR.Core.Enums.ContractType.Permanent)
    {
      TempService.TempEmployee.ContractEndDate = null;
      durationValue = 0;
    }
    else
    {
      // Default to 6 months if they switch to Contract/Internship for the first time
      if (durationValue == 0) durationValue = 6;
      Calculate();
    }
  }

  private void HandleDurationInput(ChangeEventArgs e)
  {
    if (int.TryParse(e.Value?.ToString(), out int val))
    {
      durationValue = val;
      Calculate();
    }
  }

  private void Calculate()
  {
    // Use the HireDate from the employee model, or today as fallback
    var baseDate = TempService.TempEmployee.HireDate == default
                   ? DateTime.Today
                   : TempService.TempEmployee.HireDate;

    if (durationValue > 0)
    {
      if (durationUnit == "Months")
      {
        TempService.TempEmployee.ContractEndDate = baseDate.AddMonths(durationValue);
      }
      else if (durationUnit == "Years")
      {
        TempService.TempEmployee.ContractEndDate = baseDate.AddYears(durationValue);
      }
    }

    // Forces the UI to refresh the calculated date field
    StateHasChanged();
  }
  private void SelectCountry(Country country)
  {
    selectedCountry = country;
    TempService.TempEmployee.CountryId = country.Id;
  }
  // Handle county change event
  private async Task HandleCountyChange(ChangeEventArgs e)
  {
    var selectedId = e.Value?.ToString();

    if (Guid.TryParse(selectedId, out Guid countyId))
    {
      // 1. Manually update your TempService (since we aren't using @bind)
      TempService.TempEmployee.CountyId = countyId;
      TempService.TempEmployee.County = countiesList?.FirstOrDefault(c => c.Id == countyId);

      // 2. Filter the subcounties for the UI
      filteredSubCounties = await Db.SubCounties
          .Where(s => s.CountyId == countyId)
          .OrderBy(s => s.Name)
          .ToListAsync();
    }
    else
    {
      TempService.TempEmployee.CountyId = null;
      TempService.TempEmployee.County = null; // Clear the object
      filteredSubCounties.Clear();
    }

    // 3. Clear the SubCountyId in TempEmployee so the user is forced to pick a new one
    TempService.TempEmployee.SubCountyId = null;
    TempService.TempEmployee.SubCounty = null; // Clear the object
  }
  // Update subcounties when county changes
  private async Task OnCountyChanged(ChangeEventArgs e)
  {
    var value = e.Value?.ToString();

    if (Guid.TryParse(value, out Guid selectedCountyId))
    {
      TempService.TempEmployee.CountyId = selectedCountyId;


      // SMART FILTER: Only get SubCounties where CountyId matches
      filteredSubCounties = await Db.SubCounties
          .Where(s => s.CountyId == selectedCountyId)
          .OrderBy(s => s.Name)
          .ToListAsync();
    }
    else
    {
      filteredSubCounties.Clear();
    }

    // Reset SubCounty selection so they don't have an old one from a different county
    TempService.TempEmployee.SubCountyId = null;
  }

  // Exit the form and discard changes=========================
  private void ExitForm()
  {
    Navigation.NavigateTo("/employees/list");
  }
  //private Employee employee = new Employee();
  // private EditContext? editContext;
  List<Department> departments = new();
  List<Ethnicity> ethnicities = new();
  // We need this to manage component state during navigation

  protected override async Task OnInitializedAsync()
  {
    // Make sure TempEmployee exists
    //employee = TempService.TempEmployee ?? new Employee();


    // Now create EditContext
    //editContext = new EditContext(TempService.TempEmployee!);

    // Load departments
    departments = await Db.Departments.ToListAsync();
    // Load ethnicities
    ethnicities = await Db.Ethnicities.ToListAsync();
    // Load countries for phone codes
    countries = await Db.Countries.OrderBy(c => c.Name).ToListAsync();
    // Load the 47 counties
    // If CountyId already exists (coming from Job Application), load matching SubCounties
    if (TempService.TempEmployee.CountyId != null)
    {
      filteredSubCounties = await Db.SubCounties
          .Where(s => s.CountyId == TempService.TempEmployee.CountyId)
          .OrderBy(s => s.Name)
          .ToListAsync();
    }


    countiesList = await Db.Counties.OrderBy(c => c.Name).ToListAsync();
    // SET DEFAULT TO KENYA if it's a new employee
    var kenya = countries.FirstOrDefault(c => c.IsoCode == "KE");
    if (kenya != null)
    {
      SelectCountry(kenya);
    }

  }

  private async Task Save()
  {
    // Since all inputs bind directly to TempService.TempEmployee,
    // The service already has the updated values.
    //Na ongeza validation hapa ya email unique kabla ya ku navigate
    // Re-run check just in case mtu aweke enye iko ndani form na asubmit
    await CheckEmailUniqueness();

    // SMART CLEANING LOGIC
    if (selectedCountry != null && !string.IsNullOrWhiteSpace(TempService.TempEmployee.Phone))
    {
      // Format phone number to 
      // Clean: Remove '0' and all non-numeric chars
      var digitsOnly = new string(TempService.TempEmployee.Phone.Where(char.IsDigit).ToArray());
      // STRICT CHECK: If it's not 9 or 10 digits, STOP HERE.
      if (digitsOnly.Length < 9 || digitsOnly.Length > 10)
      {
        return; // The UI validation message will already be showing the error
      }

      if (digitsOnly.StartsWith("0")) digitsOnly = digitsOnly.Substring(1);

      // Result: 254712345678
      string dial = selectedCountry.DialCode.Replace("+", "");
      TempService.TempEmployee.Phone = dial + digitsOnly;
    }

    if (!isEmailValid) return; // Stop if email is bad
    // Just navigate to the next step:
    Navigation.NavigateTo($"/employees/additional");
  }

  private void OnInvalidSubmit(EditContext ctx)
  {
    Console.WriteLine("Form invalid - touch all fields to see validation messages.");
    foreach (var m in ctx.GetValidationMessages())
      Console.WriteLine("Validation: " + m);
  }

  // Handle image file selection=========IMAGE UPLOAD==================PICHA===========================
  private DotNetObjectReference<Create>? _objRef;
  private ElementReference fileInput; // For clearing the input
  private async Task RemoveImage()
  {
    // 1. Clear the data in the service
    TempService.TempEmployee.Photo = null;

    // 2. Clear the actual HTML input so it doesn't show the old filename
    await JS.InvokeVoidAsync("eval", "document.getElementById('profileInput').value = ''");

    StateHasChanged();
  }
  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (firstRender)
    {
      // Create the reference to THIS component instance
      _objRef = DotNetObjectReference.Create(this);

      // Pass the reference to your JS file so it can "call back" to C#
      // 'setImageHelper' is the function in your imageManager.js
      await JS.InvokeVoidAsync("setImageHelper", _objRef);
    }
  }

  [JSInvokable]
  public void OnImageProcessed(string base64Data)
  {
    if (string.IsNullOrWhiteSpace(base64Data)) return;

    // Split the "data:image/webp;base64," part
    var parts = base64Data.Split(',');
    if (parts.Length > 1)
    {
      TempService.TempEmployee.Photo = Convert.FromBase64String(parts[1]);
      StateHasChanged();
    }
  }

  public void Dispose()
  {
    // Important: Free up memory when the user leaves the page
    _objRef?.Dispose();
  }
  //=================END IMAGE UPLOAD========================
  //=================EMAIL UNIQUE CHECK========================
  private bool isCheckingEmail = false;
  private string? emailErrorMessage = null;
  private bool isEmailValid = false;

  private async Task CheckEmailUniqueness()
  {
    var email = TempService.TempEmployee.Email;
    emailErrorMessage = null;
    isEmailValid = false;

    if (string.IsNullOrWhiteSpace(email)) return;

    // 1. Basic Format Regex Check (Fast)
    var emailRegex = new System.Text.RegularExpressions.Regex(@"^[^@\s]+@[^@\s]+\.[^@\s]+$");
    if (!emailRegex.IsMatch(email))
    {
      emailErrorMessage = "Invalid email format.";
      return;
    }

    // 2. Database Uniqueness Check
    isCheckingEmail = true;
    try
    {
      // Check if any employee (excluding the one being edited if applicable) has this email
      var exists = await Db.Employees.AnyAsync(e => e.Email.ToLower() == email.ToLower());

      if (exists)
      {
        emailErrorMessage = "This email is already assigned to an employee.";
        isEmailValid = false;
      }
      else
      {
        isEmailValid = true;
      }
    }
    finally
    {
      isCheckingEmail = false;
    }
  }

  // Helpers for the UI Icons
  private string GetEmailStatusClass() => isEmailValid ? "bg-success text-white" : (emailErrorMessage != null ? "bg-danger text-white" : "bg-light");
  private string GetEmailIconClass() => isEmailValid ? "fas fa-check" : (emailErrorMessage != null ? "fas fa-times" : "fas fa-envelope");
